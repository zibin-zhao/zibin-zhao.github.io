---
import PageIntro from '../components/PageIntro.astro';
import EducationNote from '../components/EducationNote.astro';
import { cv } from '../data/cv';
import { pathFor, t, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="container">
  <PageIntro
    title={lang === 'en' ? 'About me' : '关于我'}
    description={lang === 'en'
      ? 'I’m Zibin. I’m from Xinhui, and I’m now doing a PhD in Bioengineering at HKUST.'
      : '我是 Zibin，来自新会，现在在香港科技大学读生物工程博士。'}
  />
  <section
    class="section two-column"
    aria-label={lang === 'en' ? 'Background and interests' : '背景与兴趣'}
  >
    <div class="about-prose">
      <p>
        {
          lang === 'en'
            ? 'Before HKUST, I studied biomedical engineering at the University of Melbourne. My research at Hsing Lab focuses on molecular diagnostics, CRISPR, and aptamer design.'
            : '来香港之前，我在墨尔本大学学习生物医学工程。现在在 Hsing 实验室，研究分子诊断、CRISPR 和适体设计。'
        }
      </p>
      <p>
        {
          lang === 'en'
            ? 'Writing software is another part of my work. CasMD brings together molecular dynamics preparation tools; DL-SELEX contains the code for my aptamer research. I keep the papers and repositories together so the work is easier to follow.'
            : '写软件也是我工作的一部分。CasMD 整理分子动力学模拟的准备工具，DL-SELEX 放适体研究的代码。我把论文和仓库放在一起，方便顺着看下去。'
        }
      </p>
      <h2>{lang === 'en' ? 'Outside the lab' : '实验室之外'}</h2>
      <p>
        {
          lang === 'en'
            ? 'I like trains, games, music, and design. I was President and Event Director of the Chinese Music Group at the University of Melbourne in 2020.'
            : '我喜欢火车、游戏、音乐和设计。2020 年在墨尔本大学中乐团担任会长兼活动总监。'
        }
      </p>
      <p>
        {
          lang === 'en'
            ? 'The smaller projects on this site come from those interests too: Medit for journaling, Singularity for playing with particles, and Yaos for readings and the seasonal calendar.'
            : '网站里的小项目也从这些兴趣延伸出来：Medit 用来写日记，Singularity 用来玩粒子，Yaos 放经文阅读和节气日历。'
        }
      </p>
      <a class="text-link" href={pathFor('projects', lang)}
        >{lang === 'en' ? 'See the projects' : '看看这些项目'} <span aria-hidden="true">→</span></a
      >
    </div>
    <aside
      class="about-index"
      aria-label={lang === 'en' ? 'Education at a glance' : '教育经历概览'}
    >
      <h2>{lang === 'en' ? 'Education' : '教育经历'}</h2>
      {
        cv.education.map((entry) => (
          <EducationNote
            school={t(entry.org, lang)}
            qualification={t(entry.title, lang)}
            period={t(entry.period, lang)}
          />
        ))
      }
      <a class="text-link" href={pathFor('cv', lang)}
        >{lang === 'en' ? 'Full CV' : '完整履历'} <span aria-hidden="true">→</span></a
      >
    </aside>
  </section>
</div>
