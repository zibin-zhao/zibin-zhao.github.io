---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import singularity from '../assets/singularity-preview.png';
import { projects } from '../data/projects';
import { profile } from '../data/profile';
import { pathFor, t, type Lang } from '../lib/i18n';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const homeProjects = ['casmd', 'medit', 'dlselex', 'yaos'].flatMap((id) =>
  projects.filter((project) => project.id === id),
);
const allPubs = await getCollection('publications');
const publications = ['nature-biotech-cas12a', 'onepot-snp-genotyping', 'dl-selex'].flatMap((id) =>
  allPubs.filter((publication) => publication.id === id),
);
---

<div class="container">
  <section class="home-opening" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="home-greeting">{lang === 'en' ? 'Hello, I’m' : '你好，我是'}</p>
      <h1 id="home-title">Zibin Zhao</h1>
      <p>
        {
          lang === 'en'
            ? 'I’m a Bioengineering PhD student at HKUST, in Hsing Lab. My research is in molecular diagnostics and computational biology.'
            : '我在香港科技大学 Hsing 实验室读生物工程博士，研究分子诊断与计算生物学。'
        }
      </p>
      <p>
        {
          lang === 'en'
            ? 'I also write code and make small applications. This is where I keep my papers, research tools, and the things I make outside the lab.'
            : '也写代码，做些小应用。这里放论文、研究工具，还有实验室之外做的东西。'
        }
      </p>
      <div class="home-links">
        <a href={pathFor('research', lang)}>{lang === 'en' ? 'Research' : '研究'}</a>
        <a href="https://github.com/zibin-zhao">GitHub <span aria-hidden="true">↗</span></a>
        <a href={'mailto:' + profile.email}
          >{lang === 'en' ? 'Email' : '邮件'} <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
    <figure class="home-window">
      <a
        href="/singularity/"
        aria-label={lang === 'en'
          ? 'Open Singularity, my browser particle experiment'
          : '打开 Singularity，浏览器里的粒子实验'}
      >
        <Image
          src={singularity}
          alt={lang === 'en'
            ? 'The spiral galaxy in Singularity, captured from the application'
            : 'Singularity 应用中的星系，实际运行截图'}
          widths={[400, 700]}
          sizes="(max-width:700px) 90vw, 330px"
          format="webp"
          quality={82}
          loading="eager"
        />
      </a>
      <figcaption>
        <a href="/singularity/">Singularity <span aria-hidden="true">↗</span></a><span
          >{lang === 'en' ? 'A browser experiment' : '一个浏览器实验'}</span
        >
      </figcaption>
    </figure>
  </section>
  <div class="home-notebook">
    <section class="home-work" id="work" aria-labelledby="work-title">
      <h2 id="work-title">{lang === 'en' ? 'Things I’ve made' : '做过的一些东西'}</h2>
      <dl class="work-index">
        {
          homeProjects.map((project) => (
            <div>
              <dt>
                <a href={project.href}>
                  {project.name}
                  <span aria-hidden="true">↗</span>
                </a>
              </dt>
              <dd>{t(project.summary, lang)}</dd>
            </div>
          ))
        }
      </dl>
      <a class="text-link" href={pathFor('projects', lang)}
        >{lang === 'en' ? 'All projects' : '全部项目'} <span aria-hidden="true">→</span></a
      >
    </section>
    <section class="home-papers" id="research" aria-labelledby="research-title">
      <h2 id="research-title">{lang === 'en' ? 'Recent papers' : '近期论文'}</h2>
      <ol class="home-paper-list">
        {
          publications.map(({ data: publication }) => (
            <li>
              <p>
                {publication.venue} <span>· {publication.year}</span>
              </p>
              <a href={publication.links.doi}>{publication.title}</a>
            </li>
          ))
        }
      </ol>
      <a class="text-link" href={pathFor('research', lang)}
        >{lang === 'en' ? 'Full publication list' : '完整论文列表'}
        <span aria-hidden="true">→</span></a
      >
    </section>
  </div>
  <p class="home-postscript">
    {
      lang === 'en'
        ? 'Outside the lab: trains, games, music, and design.'
        : '实验室之外，喜欢火车、游戏、音乐和设计。'
    }
    <a href={pathFor('about', lang)}
      >{lang === 'en' ? 'A little more about me' : '更多关于我'}
      <span aria-hidden="true">→</span></a
    >
  </p>
</div>
