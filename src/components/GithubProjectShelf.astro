---
import type { GithubProject } from '../data/github-projects';
import GithubProjectCard from './GithubProjectCard.astro';
import T from './T.astro';

interface Props {
  projects: GithubProject[];
}

const { projects } = Astro.props;
const AUTHORED_PROJECTS = new Set(['CasMD', 'Yaos']);
const shelfProjects = projects.filter((project) => !AUTHORED_PROJECTS.has(project.name));
---

<section class="github-project-shelf" aria-labelledby="github-project-shelf-title">
  <header class="github-project-shelf-heading">
    <span><T en="Open-source field notes" zh="开源田野笔记" /></span>
    <h3 id="github-project-shelf-title"><T en="More from GitHub" zh="更多 GitHub 项目" /></h3>
    <p><T en="Working repositories, research tools, and explainers from the bench." zh="来自研究一线的工作仓库、研究工具与交互解读。" /></p>
  </header>
  <div class="github-project-shelf-grid">
    {shelfProjects.map((project) => <GithubProjectCard project={project} />)}
  </div>
</section>

<style>
  .github-project-shelf {
    position: relative;
    margin-top: 88px;
  }

  .github-project-shelf-heading {
    width: min(100%, 620px);
    margin: 0 0 30px 3%;
    padding: 18px 20px;
    border: var(--stroke);
    background: var(--blue);
    box-shadow: var(--shadow-4);
    transform: rotate(.55deg);
  }

  .github-project-shelf-heading > span {
    display: inline-block;
    padding: 4px 7px;
    border: 1px solid var(--ink);
    background: var(--surface);
    font: 500 var(--text-meta)/1.3 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .github-project-shelf-heading h3 {
    margin-top: 10px;
    font: 400 clamp(30px, 5vw, 48px)/1 var(--font-display);
    letter-spacing: .01em;
    text-transform: uppercase;
  }

  .github-project-shelf-heading p {
    max-width: 58ch;
    margin-top: 9px;
    font-size: var(--text-supporting);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .github-project-shelf-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 26px;
  }

  .github-project-shelf-grid :global([data-github-project]:nth-child(even)) {
    --github-card-transform: rotate(.4deg);
    margin-top: 20px;
  }

  @media (max-width: 700px) {
    .github-project-shelf { margin-top: 64px; }
    .github-project-shelf-heading {
      width: calc(100% - 8px);
      margin: 0 0 24px 4px;
      padding: 16px;
      transform: rotate(.3deg);
    }
    .github-project-shelf-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 22px;
    }
    .github-project-shelf-grid :global([data-github-project]:nth-child(even)) { margin-top: 0; }
  }
</style>
