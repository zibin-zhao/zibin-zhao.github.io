---
// EN / 中 language toggle. Click handler lives in scripts/lang.ts.
---
<button type="button" class="langtoggle" aria-label="Switch language / 切换语言">
  <span class="seg seg-en">EN</span><span class="seg seg-zh">中</span>
</button>
<style>
  .langtoggle{display:none;min-height:40px;align-items:center;gap:2px;border:var(--stroke);padding:4px;background:var(--surface);box-shadow:var(--shadow-2);cursor:pointer;font:500 11px/1 var(--font-note);transform:rotate(1deg)}
  :global(.js) .langtoggle{display:inline-flex}
  .seg{padding:5px 8px;color:var(--muted);transition:background .15s,color .15s}
  :global([data-lang="en"]) .seg-en{background:var(--ink);color:#fff}
  :global([data-lang="zh"]) .seg-zh{background:var(--ink);color:#fff}
</style>
