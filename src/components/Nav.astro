---
import { profile } from '../data/profile';
import T from './T.astro';
import LangToggle from './LangToggle.astro';
---
<header class="topnav" id="topnav">
  <a class="index-label" href="#top">ZIBINZHAO.COM · <span class="t-en">UNFINISHED INDEX</span><span class="t-zh">未完成索引</span></a>
  <div class="nav-actions">
    <button class="menubtn" id="menubtn" type="button" aria-expanded="false" aria-controls="navlinks"><T en="Index" zh="索引" /></button>
    <nav id="navlinks" aria-label="Site chapters">
      {profile.navLinks.map((link) => <a href={link.href}><T en={link.en} zh={link.zh} /></a>)}
    </nav>
    <LangToggle />
    <a class="talk" href={`mailto:${profile.email}`}><T en="Let's talk ↗" zh="联系我 ↗" /></a>
  </div>
</header>

<style>
  .topnav {
    position: static;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    padding: 20px var(--page-pad) 0;
  }

  :global(.js) .topnav {
    position: fixed;
    top: 20px;
    right: var(--page-pad);
    left: var(--page-pad);
    z-index: 50;
    flex-wrap: nowrap;
    padding: 0;
    pointer-events: none;
  }

  .index-label {
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
    pointer-events: auto;
    transition: transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  .index-label {
    display: flex;
    max-width: min(50vw, 390px);
    min-height: 40px;
    align-items: center;
    padding: 10px 14px;
    font: 500 clamp(9px, 1.1vw, 12px)/1.25 var(--font-note);
    letter-spacing: .035em;
    text-transform: uppercase;
    transform: rotate(-1deg);
  }

  .nav-actions {
    position: static;
    display: flex;
    flex: 1 1 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 0;
    pointer-events: auto;
  }

  :global(.js) .nav-actions {
    position: relative;
    flex: 0 1 auto;
    flex-wrap: nowrap;
    padding: 6px;
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
    transform: rotate(1deg);
    transition: transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  :global(.js) .topnav.scrolled .index-label,
  :global(.js) .topnav.scrolled .nav-actions {
    box-shadow: 1px 1px 0 var(--ink);
    transform: translate(2px, 2px) rotate(0);
  }

  .menubtn,
  .talk {
    min-height: 40px;
    border: 1px solid var(--ink);
    padding: 8px 10px;
    background: var(--paper);
    cursor: pointer;
    font: 500 10px/1 var(--font-note);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .menubtn { display: none; }
  :global(.js) .menubtn { display: block; }
  .talk { background: var(--green); }

  #navlinks {
    position: static;
    display: flex;
    width: 100%;
    min-width: 0;
    flex: 1 1 100%;
    flex-wrap: wrap;
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  :global(.js) #navlinks {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    display: grid;
    width: auto;
    min-width: 190px;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity var(--motion-fast), transform var(--motion-fast), visibility 0s linear var(--motion-fast);
    pointer-events: none;
  }

  :global(.js) #navlinks.open {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s, 0s, 0s;
    pointer-events: auto;
  }

  #navlinks a {
    display: flex;
    flex: 1 1 120px;
    min-height: 40px;
    align-items: center;
    border-bottom: 1px dashed var(--outline);
    padding: 10px 14px;
    font: 500 10px/1.2 var(--font-note);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  #navlinks a:last-child { border-bottom: 0; }
  #navlinks a:hover { background: var(--green); }

  .nav-actions :global(.langtoggle) {
    display: none;
    min-height: 40px;
    border: 1px solid var(--ink);
    border-radius: 0;
    background: var(--paper);
  }

  :global(.js) .nav-actions :global(.langtoggle) { display: inline-flex; }

  .nav-actions :global(.seg) {
    border-radius: 0;
    color: var(--ink);
    font-family: var(--font-note);
    font-size: 10px;
  }

  .nav-actions :global([data-lang='en'] .seg-en),
  .nav-actions :global([data-lang='zh'] .seg-zh) {
    background: var(--ink);
    color: var(--paper);
  }

  @media (max-width: 700px) {
    .topnav {
      gap: 8px;
      padding: 12px;
    }

    :global(.js) .topnav {
      top: 12px;
      right: 12px;
      left: 12px;
      padding: 0;
    }

    .index-label {
      max-width: 44vw;
      min-height: 40px;
      padding: 8px 9px;
      font-size: 8px;
    }

    .nav-actions { gap: 4px; }
    :global(.js) .nav-actions { padding: 4px; }
    .menubtn, .talk { min-height: 40px; padding: 7px; font-size: 8px; }
    .nav-actions :global(.langtoggle) { min-height: 40px; padding: 2px; }
    .nav-actions :global(.seg) { padding: 4px; font-size: 9px; }
  }

  @media (max-width: 470px) {
    .index-label { max-width: 42vw; }
    .talk { display: none; }
  }
</style>
