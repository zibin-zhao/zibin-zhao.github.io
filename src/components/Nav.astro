---
import { profile } from '../data/profile';
import T from './T.astro';
import LangToggle from './LangToggle.astro';
---
<header class="topnav" id="topnav">
  <a class="logo" href="#top">{profile.name}</a>
  <nav id="navlinks">{profile.navLinks.map(l => <a href={l.href}><T en={l.en} zh={l.zh} /></a>)}</nav>
  <div class="navright">
    <LangToggle />
    <a class="cta" href={`mailto:${profile.email}`}><T en="Let's Talk ↗" zh="联系我 ↗" /></a>
    <button class="menubtn" id="menubtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="navlinks">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<script is:inline>
  (() => {
    const btn = document.getElementById('menubtn');
    const nav = document.getElementById('navlinks');
    if (!btn || !nav) return;
    const close = () => { nav.classList.remove('open'); btn.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = nav.classList.toggle('open');
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
    nav.addEventListener('click', (e) => { if (e.target.closest('a')) close(); });
    document.addEventListener('click', (e) => { if (!e.target.closest('#topnav')) close(); });
  })();
</script>
<style>
  .topnav{position:fixed;top:var(--gap);left:var(--gap);right:var(--gap);z-index:50;display:flex;justify-content:space-between;align-items:center;
    padding:10px 12px 10px 18px;border:1.5px solid var(--ink);background:var(--paper-warm);box-shadow:var(--shadow-sticker);
    opacity:0;transform:translateY(-14px) rotate(-.6deg);transition:opacity .45s,transform .45s;pointer-events:none}
  .topnav.show{opacity:1;transform:rotate(-.6deg);pointer-events:auto}
  .topnav .logo{font-family:var(--font-display);font-weight:800;letter-spacing:-1.2px;font-size:17px;text-transform:uppercase}
  .topnav nav{display:flex;gap:7px;font:700 10px/1 var(--font-note);letter-spacing:.04em;text-transform:uppercase;color:var(--ink)}
  .topnav nav a{border-bottom:1px solid transparent;padding:5px 3px;transition:transform var(--motion-fast) var(--ease-spring),border-color var(--motion-fast)}
  .topnav nav a:hover{border-color:var(--ink);transform:rotate(-4deg)}
  .navright{display:flex;align-items:center;gap:10px}
  .topnav :global(.langtoggle){border:1px solid var(--ink);border-radius:0;background:var(--paper)}
  .topnav :global(.seg){color:var(--ink)}.topnav :global([data-lang="en"] .seg-en),.topnav :global([data-lang="zh"] .seg-zh){background:var(--ink);color:var(--paper)}
  .topnav .cta{border:1px solid var(--ink);background:var(--green-light);box-shadow:2px 2px 0 var(--ink);padding:8px 10px;font:700 10px/1 var(--font-note);letter-spacing:.04em;text-transform:uppercase}
  .menubtn{display:none;flex-direction:column;justify-content:center;gap:4px;width:34px;height:34px;padding:0 7px;border:1px solid var(--ink);border-radius:0;background:var(--blue);cursor:pointer}
  .menubtn span{display:block;height:2px;background:var(--ink);transition:transform .25s,opacity .25s}
  .menubtn.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
  .menubtn.open span:nth-child(2){opacity:0}
  .menubtn.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
  @media (max-width:640px){
    .menubtn{display:flex}
    .topnav nav{position:absolute;top:calc(100% + 8px);right:0;left:0;flex-direction:column;gap:0;
      border:1.5px solid var(--ink);background:var(--paper);box-shadow:var(--shadow-sticker);
      padding:6px;opacity:0;transform:translateY(-8px);pointer-events:none;transition:opacity .2s,transform .2s}
    .topnav nav.open{opacity:1;transform:none;pointer-events:auto}
    .topnav nav a{padding:11px 12px}
    .topnav nav a:hover{background:var(--orange-light)}
  }
</style>
