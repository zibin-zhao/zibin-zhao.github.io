---
const { label, text } = Astro.props;
---
<div class="pblock">
  {label && <div class="plabel">{label}</div>}
  <div class="pwrap">
    <button class="copy" type="button" aria-label="Copy prompt to clipboard">
      <span class="lbl-copy">Copy</span>
      <span class="lbl-done">Copied ✓</span>
    </button>
    <pre class="ptext">{text}</pre>
  </div>
</div>
<style>
  .pblock {
    margin-top: 20px;
  }

  .plabel {
    margin-bottom: 8px;
    color: var(--muted);
    font: 500 11px/1.45 var(--font-note);
  }

  .pwrap {
    position: relative;
    border: var(--stroke);
    background: var(--paper);
    box-shadow: var(--shadow-control);
  }

  .ptext {
    max-width: 100%;
    margin: 0;
    overflow-x: auto;
    padding: 56px 18px 18px;
    color: var(--ink);
    font: 500 12.5px/1.65 var(--font-note);
    overflow-wrap: anywhere;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .copy {
    position: absolute;
    z-index: 2;
    top: 10px;
    right: 10px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 11px;
    border: 1px solid var(--ink);
    background: var(--paper-card);
    box-shadow: 2px 2px 0 var(--ink);
    color: var(--ink);
    cursor: pointer;
    font: 500 10px/1.2 var(--font-note);
    text-transform: uppercase;
    transition: background var(--motion-fast) var(--ease-press), color var(--motion-fast) var(--ease-press), transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  .copy:hover {
    background: var(--ink);
    color: var(--paper);
  }

  .copy:active {
    box-shadow: 1px 1px 0 var(--ink);
    transform: translate(1px, 1px);
  }

  .lbl-done {
    display: none;
  }

  .copy.copied {
    background: var(--green-bright);
    color: var(--ink);
  }

  .copy.copied .lbl-copy {
    display: none;
  }

  .copy.copied .lbl-done {
    display: inline;
  }

  @media (max-width: 520px) {
    .copy {
      position: static;
      margin: 12px 0 0 12px;
    }

    .ptext {
      padding: 12px;
      font-size: 11.5px;
      line-height: 1.6;
    }
  }
</style>
