---
import { getGithubProjects, partitionGithubProjects } from '../data/github-projects';
import ResearchProjectCard from './ResearchProjectCard.astro';
import T from './T.astro';

const githubProjects = await getGithubProjects();
const { research } = partitionGithubProjects(githubProjects);
const casmd = research.find(({ name }) => name === 'CasMD');
const tempo = research.find(({ name }) => name === 'TEMPO');
const remaining = research.filter((project) => !['CasMD', 'TEMPO'].includes(project.name));
const casmdImage = {
  src: '/stitch/casmd-cartoon.png',
  alt: 'CasMD molecular dynamics research project illustration',
};
---

<section class="stitch-research-projects" id="research-projects" aria-labelledby="research-projects-title">
  <header class="research-projects-heading">
    <p><T en="From research to working tools" zh="从研究走向可用工具" /></p>
    <h2 id="research-projects-title"><T en="Research Projects" zh="研究项目" /></h2>
  </header>

  <div class="research-projects-grid">
    {casmd && <ResearchProjectCard project={casmd} image={casmdImage} />}
    {tempo && <ResearchProjectCard project={tempo} />}
    {remaining.map((project) => <ResearchProjectCard project={project} />)}
  </div>
</section>

<style>
  .stitch-research-projects {
    position: relative;
    z-index: 20;
    width: min(var(--canvas-max), calc(100% - (2 * var(--page-pad))));
    margin: 0 auto clamp(88px, 11vw, 144px);
    scroll-margin-top: 96px;
  }

  .research-projects-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(28px, 5vw, 52px);
  }

  .research-projects-heading p {
    max-width: 28ch;
    padding: 8px 11px;
    border: 1px solid var(--ink);
    background: var(--green-bright);
    font: 500 var(--text-meta)/1.4 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    transform: rotate(-1deg);
  }

  h2 {
    max-width: 12ch;
    font: 400 clamp(42px, 7vw, 76px)/.92 var(--font-display);
    letter-spacing: -.02em;
    text-align: right;
    text-transform: uppercase;
  }

  .research-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px);
    align-items: stretch;
  }

  .research-projects-grid :global([data-research-project='CasMD']) { grid-row: span 2; }
  .research-projects-grid :global([data-research-project]:nth-child(3n)) { transform: rotate(.45deg); }

  @media (max-width: 700px) {
    .stitch-research-projects { width: min(100% - 36px, 440px); margin-bottom: 88px; }
    .research-projects-heading { align-items: flex-start; flex-direction: column-reverse; gap: 18px; }
    h2 { text-align: left; }
    .research-projects-grid { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .research-projects-grid :global([data-research-project]) { grid-row: auto; transform: none; }
  }
</style>
