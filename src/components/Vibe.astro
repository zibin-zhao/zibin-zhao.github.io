---
import Section from './Section.astro';
import VibeCard from './VibeCard.astro';
import T from './T.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('vibe')).sort((a,b)=>a.data.order-b.data.order);
---
<Section id="vibe" num="04" label="Vibe Coding" labelZh="随性编程">
  <h2 class="big"><T en="Built for the joy of it 🛠️" zh="为热爱而造 🛠️" /></h2>
  <p class="muted t-en">Things I've vibe-coded — shipped fast with AI pair-programming. Side projects where curiosity leads and the build follows.</p>
  <p class="muted t-zh">我随性编写的小项目 —— 借助 AI 结对编程快速落地。好奇心在前，代码随后。</p>
  <div class="grid">
    {items.map(v => <VibeCard {...v.data} />)}
    <div class="addcard"><div class="plus">+</div><div><T en="Open slot — more projects to come" zh="虚位以待，更多项目即将到来" /></div></div>
  </div>
</Section>
<style>
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:30px}
  .addcard{border:2px dashed #d7d7db;border-radius:18px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:#a1a1aa;min-height:240px;text-align:center}
  .plus{font-size:34px;font-weight:300;line-height:1}
  @media (max-width:760px){.grid{grid-template-columns:1fr}}
</style>
