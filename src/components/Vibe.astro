---
import Section from './Section.astro';
import VibeCard from './VibeCard.astro';
import T from './T.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('vibe')).sort((a,b)=>a.data.order-b.data.order);
---
<Section id="vibe" num="04" label="Vibe Coding" labelZh="随性编程" variant="scrap">
  <h2 class="big"><T en="Built for the joy of it" zh="为热爱而造" /></h2>
  <p class="muted t-en">Things I've vibe-coded — shipped fast with AI pair-programming. Side projects where curiosity leads and the build follows.</p>
  <p class="muted t-zh">我随性编写的小项目 —— 借助 AI 结对编程快速落地。好奇心在前，代码随后。</p>
  <div class="vibe-board">
    {items.map((item) => <VibeCard {...item.data} />)}
    <div class="open-slot"><span>+</span><T en="Open slot — more projects to come" zh="虚位以待，更多项目即将到来" /></div>
  </div>
</Section>
<style>
  .big {
    max-width: 13ch;
    font: 400 clamp(40px, 6vw, 72px)/.95 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .muted {
    max-width: 68ch;
    margin-top: 22px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .vibe-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(22px, 4vw, 38px);
    margin-top: clamp(34px, 6vw, 60px);
  }

  .open-slot {
    display: flex;
    min-height: 280px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 30px;
    border: 2px dashed var(--ink);
    background: rgb(255 250 224 / 72%);
    color: var(--muted);
    font: 500 12px/1.55 var(--font-note);
    text-align: center;
    transform: translateY(10px) rotate(.5deg);
  }

  .open-slot span {
    color: var(--ink);
    font: 400 48px/1 var(--font-display);
  }

  @media (max-width: 780px) {
    .vibe-board {
      grid-template-columns: minmax(0, 1fr);
    }

    .open-slot {
      min-height: 190px;
      transform: none;
    }
  }
</style>
