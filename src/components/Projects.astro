---
import { getGithubProjects } from '../data/github-projects';
import GithubProjectCard from './GithubProjectCard.astro';
import Section from './Section.astro';
import T from './T.astro';

const githubProjects = await getGithubProjects();
---
<Section id="projects" num="03" label="Projects & Demos" labelZh="项目与演示" variant="scrap">
  <h3 class="big"><T en="Things I've built" zh="我做过的东西" /></h3>
  <div class="project-board">{githubProjects.map((project) => <GithubProjectCard project={project} />)}</div>
</Section>
<style>
  .big {
    max-width: 12ch;
    font: 400 clamp(40px, 6vw, 72px)/.95 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .project-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 40px);
    align-items: start;
    margin-top: clamp(30px, 5vw, 52px);
  }

  .project-board :global([data-featured='true']) { grid-column: span 2; }
  .project-board :global([data-github-project]:nth-child(even)) { --github-card-transform: rotate(.45deg); }

  @media (max-width: 780px) {
    .project-board {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .project-board :global([data-github-project]) {
      grid-column: 1;
    }
  }
</style>
