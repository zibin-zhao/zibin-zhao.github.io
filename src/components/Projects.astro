---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import T from './T.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Section id="projects" num="03" label="Projects & Demos" labelZh="项目与演示" variant="scrap">
  <h3 class="big"><T en="Things I've built" zh="我做过的东西" /></h3>
  <div class="project-board">{items.map((project) => <ProjectCard {...project.data} />)}</div>
</Section>
<style>
  .big {
    max-width: 12ch;
    font: 400 clamp(40px, 6vw, 72px)/.95 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .project-board {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 3vw, 30px);
    margin-top: clamp(30px, 5vw, 52px);
  }

  @media (max-width: 780px) {
    .project-board {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
