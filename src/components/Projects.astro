---
import Section from './Section.astro';
import ProjectCard from './ProjectCard.astro';
import T from './T.astro';
import { getCollection } from 'astro:content';
const items = (await getCollection('projects')).sort((a,b)=>a.data.order-b.data.order);
---
<Section id="projects" num="03" label="Projects & Demos" labelZh="项目与演示" variant="scrap">
  <h3 class="big"><T en="Things I've built" zh="我做过的东西" /></h3>
  <div class="project-board">{items.map((project) => <ProjectCard {...project.data} />)}</div>
</Section>
<style>
  .big {
    max-width: 12ch;
    font: 400 clamp(40px, 6vw, 72px)/.95 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .project-board {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 44px) clamp(8px, 1.5vw, 16px);
    align-items: start;
    margin-top: clamp(30px, 5vw, 52px);
  }

  .project-board :global(.project-card:nth-child(1)) {
    z-index: 2;
    grid-column: 1 / span 7;
    grid-row: 1;
    --project-transform: rotate(-.7deg);
  }

  .project-board :global(.project-card:nth-child(2)) {
    z-index: 4;
    grid-column: 7 / span 6;
    grid-row: 1;
    margin-top: 58px;
    --project-transform: rotate(.85deg);
  }

  .project-board :global(.project-card:nth-child(3)) {
    z-index: 1;
    grid-column: 2 / span 5;
    grid-row: 2;
    margin-top: -14px;
    --project-transform: rotate(.45deg);
  }

  .project-board :global(.project-card:nth-child(4)) {
    z-index: 3;
    grid-column: 6 / span 7;
    grid-row: 2;
    margin-top: -62px;
    --project-transform: rotate(-.65deg);
  }

  @media (max-width: 780px) {
    .project-board {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    .project-board :global(.project-card:nth-child(n)) {
      z-index: auto;
      grid-column: 1;
      grid-row: auto;
      margin-top: 0;
    }

    .project-board :global(.project-card:nth-child(1)) { --project-transform: rotate(-.25deg); }
    .project-board :global(.project-card:nth-child(2)) { --project-transform: rotate(.3deg); }
    .project-board :global(.project-card:nth-child(3)) { --project-transform: rotate(-.2deg); }
    .project-board :global(.project-card:nth-child(4)) { --project-transform: rotate(.25deg); }
  }
</style>
