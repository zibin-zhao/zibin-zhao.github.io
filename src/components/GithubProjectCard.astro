---
import type { GithubProject } from '../data/github-projects';
import T from './T.astro';

interface Props {
  project: GithubProject;
}

const { project } = Astro.props;
---

<article
  class:list={['github-project-card', project.featured && 'github-project-card--featured']}
  data-github-project={project.name}
  data-featured={project.featured ? 'true' : undefined}
>
  <header class="github-project-heading">
    {project.featured && (
      <span class="github-project-featured"><span aria-hidden="true">★</span> <T en="Featured" zh="精选" /></span>
    )}
    <h3>{project.name}</h3>
  </header>

  <p class="github-project-description"><T en={project.description} zh={project.descriptionZh} /></p>

  <ul class="github-project-stack" aria-label={`${project.name} technologies`}>
    {project.stack.map((technology) => <li>{technology}</li>)}
  </ul>

  <div class="github-project-actions">
    <a
      class="github-project-action github-project-action--code"
      href={project.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`${project.name} on GitHub (opens in a new tab)`}
    ><T en="GitHub ↗" zh="GitHub ↗" /></a>
    {project.demoUrl && (
      <a
        class="github-project-action github-project-action--demo"
        href={project.demoUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${project.name} live demo (opens in a new tab)`}
      ><T en="Live demo ↗" zh="在线演示 ↗" /></a>
    )}
  </div>
</article>

<style>
  .github-project-card {
    --github-card-transform: rotate(-.35deg);
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    padding: clamp(18px, 3vw, 28px);
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-4);
    color: var(--ink);
    transform: var(--github-card-transform);
    transition: box-shadow var(--motion-fast) var(--ease-press), transform var(--motion-fast) var(--ease-press);
  }

  .github-project-card::before {
    position: absolute;
    top: -8px;
    right: 18px;
    width: 54px;
    height: 15px;
    border: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    background: color-mix(in srgb, var(--blue) 72%, transparent);
    content: '';
    transform: rotate(2deg);
  }

  .github-project-card--featured {
    border-width: 3px;
    background: var(--surface);
    box-shadow: 7px 7px 0 var(--orange);
  }

  .github-project-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 9px 14px;
    padding-bottom: 12px;
    border-bottom: 2px dashed var(--ink);
  }

  .github-project-heading h3 {
    min-width: 0;
    flex: 1 1 240px;
    font: 400 clamp(26px, 4vw, 38px)/1 var(--font-display);
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .github-project-featured {
    order: 2;
    padding: 5px 7px;
    border: 1px solid var(--ink);
    background: var(--orange);
    font: 500 var(--text-meta)/1.2 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
    transform: rotate(1deg);
  }

  .github-project-description {
    max-width: 68ch;
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--text-supporting);
    line-height: 1.55;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .github-project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
    list-style: none;
  }

  .github-project-stack li {
    padding: 4px 7px;
    border: 1px solid var(--ink);
    background: var(--green-bright);
    font: 500 var(--text-meta)/1.25 var(--font-note);
  }

  .github-project-stack li:nth-child(even) { background: var(--blue); }

  .github-project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 22px;
  }

  .github-project-action {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 9px 12px;
    border: var(--stroke);
    box-shadow: var(--shadow-2);
    font: 500 var(--text-action)/1.3 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .github-project-action--code { background: var(--ink); color: var(--surface); }
  .github-project-action--demo { background: var(--orange); color: var(--ink); }

  .github-project-action:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
    box-shadow: 0 0 0 5px var(--paper), var(--shadow-2);
  }

  @media (hover: hover) {
    .github-project-card:has(.github-project-action:hover) {
      box-shadow: var(--shadow-8);
      transform: translate(-2px, -2px) var(--github-card-transform);
    }

    .github-project-action:hover { background: var(--green-bright); color: var(--ink); }
  }

  @media (prefers-reduced-motion: reduce) {
    .github-project-card { transition: none; }
    .github-project-card:has(.github-project-action:hover) {
      box-shadow: var(--shadow-4);
      transform: var(--github-card-transform);
    }
    .github-project-card--featured:has(.github-project-action:hover) { box-shadow: 7px 7px 0 var(--orange); }
  }

  @media (max-width: 700px) {
    .github-project-card { padding: 18px; transform: none; }
    .github-project-card:has(.github-project-action:hover) { transform: none; }
    .github-project-heading h3 { font-size: clamp(25px, 9vw, 34px); }
    .github-project-featured { order: initial; }
    .github-project-action { flex: 1 1 136px; }
  }
</style>
