---
import Section from './Section.astro';
import { cv } from '../data/cv';
import T from './T.astro';
const items = [...cv.education, ...cv.experience, ...cv.leadership];
---
<Section id="cv" num="05" label="CV / Resume" labelZh="简历" variant="strip">
  <div class="cvgrid">
    <div class="tl">
      {items.map(i => (
        <div class="item">
          <h4><T en={`${i.title.en} — ${i.org.en}`} zh={`${i.title.zh} — ${i.org.zh}`} /></h4>
          <div class="meta">
            <span class="t-en">{[i.period.en, ...i.notes.en].filter(Boolean).join(' · ')}</span>
            <span class="t-zh">{[i.period.zh, ...i.notes.zh].filter(Boolean).join(' · ')}</span>
          </div>
        </div>
      ))}
    </div>
    <div>
      <div class="chips">{cv.skills.map(s => <span class="chip">{s}</span>)}</div>
      <a class="download" href={cv.pdf} download><T en={cv.download.en} zh={cv.download.zh} /></a>
    </div>
  </div>
</Section>
<style>
  .cvgrid{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:18px}.tl{border-left:2px solid var(--ink);margin-left:6px;padding-left:20px}
  .item{margin-bottom:16px;position:relative}
  .item::before{content:"";position:absolute;left:-26px;top:5px;width:9px;height:9px;border-radius:50%;background:var(--ink)}
  .item h4{font-size:14px}.meta{font-size:12px;color:var(--muted)}
  .download{display:inline-block;margin-top:16px;border:1.5px solid var(--ink);background:var(--blue);box-shadow:var(--shadow-sticker);padding:11px 14px;font:700 11px/1 var(--font-note);text-transform:uppercase}
  @media (max-width:760px){.cvgrid{grid-template-columns:1fr}}
</style>
