---
import Section from './Section.astro';
import { cv } from '../data/cv';
import T from './T.astro';

const currentStudy = cv.education[0];
---

<Section id="cv" num="05" label="CV / Resume" labelZh="简历" variant="strip">
  <div class="cv-layout">
    <ol class="cv-index">
      <li class="cv-entry" data-cv-entry="PhD @ HKUST">
        <span class="cv-num" aria-hidden="true">01</span>
        <div class="cv-copy">
          <h3><T en="PhD @ HKUST" zh="博士研究 @ 香港科技大学" /></h3>
          <p class="t-en">{[currentStudy.period.en, ...currentStudy.notes.en].filter(Boolean).join(' · ')}</p>
          <p class="t-zh">{[currentStudy.period.zh, ...currentStudy.notes.zh].filter(Boolean).join(' · ')}</p>
        </div>
      </li>
    </ol>

    <aside class="cv-tools" aria-label="CV skills">
      <div class="chips">{cv.skills.map((skill) => <span class="chip">{skill}</span>)}</div>
      <a class="download" href={cv.pdf} download>
        <T en={cv.download.en} zh={cv.download.zh} />
      </a>
    </aside>
  </div>
</Section>

<style>
  .cv-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, .36fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: start;
  }

  .cv-index {
    min-width: 0;
    border-top: 2px dashed var(--outline);
    list-style: none;
  }

  .cv-entry {
    display: grid;
    grid-template-columns: clamp(42px, 6vw, 68px) minmax(0, 1fr);
    gap: clamp(12px, 2.5vw, 26px);
    padding: clamp(19px, 3vw, 30px) 0;
    border-bottom: 2px dashed var(--outline);
  }

  .cv-num {
    color: var(--orange);
    font: 400 clamp(28px, 4.5vw, 48px)/.9 var(--font-display);
    letter-spacing: .02em;
  }

  .cv-copy {
    min-width: 0;
  }

  .cv-copy h3 {
    max-width: 38ch;
    font-size: clamp(17px, 2.2vw, 23px);
    line-height: 1.15;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .cv-copy p {
    max-width: 70ch;
    margin-top: 9px;
    color: var(--muted);
    font: 500 12px/1.65 var(--font-note);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .cv-tools {
    padding: clamp(20px, 3vw, 28px);
    border: var(--stroke);
    background: var(--green);
    box-shadow: var(--shadow-6);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    padding: 7px 9px;
    border: 1px solid var(--ink);
    background: var(--paper);
    font: 500 11px/1 var(--font-note);
  }

  .download {
    display: inline-flex;
    max-width: 100%;
    margin-top: 24px;
    padding: 12px 14px;
    border: 2px solid var(--ink);
    background: var(--orange);
    box-shadow: var(--shadow-control);
    font: 500 11px/1.3 var(--font-note);
    text-transform: uppercase;
    transition: transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  .download:hover {
    box-shadow: 1px 1px 0 var(--ink);
    transform: translate(2px, 2px);
  }

  @media (max-width: 780px) {
    .cv-layout {
      grid-template-columns: 1fr;
    }

    .cv-tools {
      box-shadow: var(--shadow-control);
    }
  }

  @media (max-width: 420px) {
    .cv-entry {
      grid-template-columns: 36px minmax(0, 1fr);
    }

    .cv-num {
      font-size: 27px;
    }
  }
</style>
