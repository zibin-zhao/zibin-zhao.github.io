---
import T from './T.astro';
const { title, titleZh, blurb, blurbZh, tags = [], href, screenshot, comingSoon } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener' : undefined}>
  <div class="shot">{screenshot ? <img src={screenshot} alt={`${title} screenshot`} width="800" height="600" loading="lazy" /> : <T en="Image / experiment holder — awaiting an original screenshot" zh="图像 / 实验占位区 —— 等待原创截图" />}</div>
  <div class="body">
    <div class="ttl">{title} {titleZh && <span class="zh">{titleZh}</span>}</div>
    <p class="desc"><T en={blurb} zh={blurbZh ?? blurb} /></p>
    <div class="tags">{tags.map(t => <span class="t">{t}</span>)}</div>
    <span class="go">{comingSoon ? <T en="Coming soon" zh="即将上线" /> : <T en="View →" zh="查看 →" />}</span>
  </div>
</Tag>
<style>
  .card{display:flex;flex-direction:column;overflow:hidden;border:1.5px solid var(--ink);background:var(--paper);box-shadow:var(--shadow-sticker);transition:transform var(--motion-fast) var(--ease-spring),box-shadow var(--motion-fast)}
  .card:nth-child(2n){background:var(--orange-light);transform:rotate(-1deg)}
  a.card:hover{transform:translate(-5px,-5px) rotate(2deg);box-shadow:10px 10px 0 var(--ink)}
  .shot{display:flex;aspect-ratio:4/3;align-items:center;justify-content:center;border-bottom:1.5px dashed var(--ink);background:repeating-linear-gradient(45deg,rgba(141,211,241,.62),rgba(141,211,241,.62) 12px,rgba(255,253,246,.72) 12px,rgba(255,253,246,.72) 24px);padding:18px;color:var(--ink);font:700 10px/1.45 var(--font-note);letter-spacing:.05em;text-align:center;text-transform:uppercase}
  .shot img{width:100%;height:100%;object-fit:cover}
  .body{padding:18px}.ttl{display:flex;align-items:center;gap:8px;font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:500}.zh{color:var(--muted);font:10px/1 var(--font-note)}
  .desc{margin:8px 0 12px;color:var(--muted);font-size:13px;line-height:1.55}.tags{display:flex;flex-wrap:wrap;gap:6px;margin-bottom:14px}.t{border:1px solid var(--ink);padding:3px 7px;font:700 9px/1 var(--font-note);color:var(--ink)}.go{font:700 11px/1 var(--font-note);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:760px){.card:nth-child(n){transform:none}}
</style>
