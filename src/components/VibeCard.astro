---
import T from './T.astro';

interface Props {
  title: string;
  titleZh?: string;
  blurb: string;
  blurbZh?: string;
  tags?: string[];
  href?: string;
  screenshot?: string;
  preview?: 'medit';
  comingSoon?: boolean;
}

const { title, titleZh, blurb, blurbZh, tags = [], href, screenshot, preview, comingSoon } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="card" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener' : undefined}>
  <div class:list={['shot', preview && `shot--${preview}`]}>
    {screenshot
      ? <img src={screenshot} alt={`${title} screenshot`} width="800" height="600" loading="lazy" />
      : preview === 'medit'
        ? <span class="medit-preview" aria-label="Medit: a quiet place for journaling and gentle daily rituals">☾ leaf / quiet place ☾</span>
        : <span class="shot-fallback" aria-hidden="true"><i></i><i></i><i></i><b>EXPERIMENT PREVIEW</b></span>}
  </div>
  <div class="body">
    <h3 class="ttl">{title} {titleZh && <span class="zh">{titleZh}</span>}</h3>
    <p class="desc"><T en={blurb} zh={blurbZh ?? blurb} /></p>
    <div class="tags">{tags.map(t => <span class="t">{t}</span>)}</div>
    <span class="go">{comingSoon ? <T en="Coming soon" zh="即将上线" /> : <T en="View →" zh="查看 →" />}</span>
  </div>
</Tag>
<style>
  .card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 2px solid var(--ink);
    background: var(--paper-card);
    box-shadow: var(--shadow-card);
    transition: transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  .card:nth-child(2n) {
    transform: translateY(14px) rotate(-.35deg);
  }

  a.card:hover {
    transform: translate(-3px, -3px) rotate(.35deg);
    box-shadow: 9px 9px 0 var(--ink);
  }

  .shot {
    display: flex;
    aspect-ratio: 4 / 3;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-bottom: 2px solid var(--ink);
    background: var(--green);
    color: var(--ink);
  }

  .shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shot--medit {
    background: #e8dec4;
    color: #493c22;
  }

  .medit-preview {
    max-width: calc(100% - 40px);
    padding: 12px 14px;
    border: 1px solid currentColor;
    font: 500 10px/1.35 var(--font-note);
    letter-spacing: .06em;
    text-align: center;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .shot-fallback {
    position: relative;
    display: grid;
    width: min(72%, 270px);
    aspect-ratio: 4 / 3;
    place-items: center;
    border: 2px solid var(--ink);
  }

  .shot-fallback::before,
  .shot-fallback::after {
    position: absolute;
    content: '';
  }

  .shot-fallback::before {
    inset: 12%;
    border: 1px dashed var(--ink);
  }

  .shot-fallback::after {
    width: 38%;
    aspect-ratio: 1;
    border: 2px solid var(--ink);
    border-radius: 50%;
  }

  .shot-fallback i {
    position: absolute;
    z-index: 1;
    width: 11px;
    height: 11px;
    border: 2px solid var(--ink);
    background: var(--paper);
    transform: rotate(45deg);
  }

  .shot-fallback i:nth-child(1) { top: 8%; left: 8%; }
  .shot-fallback i:nth-child(2) { top: 20%; right: 18%; background: var(--orange); }
  .shot-fallback i:nth-child(3) { right: 10%; bottom: 12%; }

  .shot-fallback b {
    z-index: 2;
    padding: 5px 7px;
    background: var(--paper);
    font: 500 8px/1.2 var(--font-note);
    letter-spacing: .04em;
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(20px, 3vw, 30px);
  }

  .ttl {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    font: 400 clamp(28px, 3vw, 38px)/1 var(--font-display);
    letter-spacing: -.02em;
    text-transform: uppercase;
  }

  .zh {
    color: var(--muted);
    font: 500 11px/1.2 var(--font-note);
  }

  .desc {
    max-width: 62ch;
    margin: 12px 0 18px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .t {
    padding: 4px 7px;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font: 500 9px/1.2 var(--font-note);
  }

  .go {
    margin-top: auto;
    font: 500 11px/1.2 var(--font-note);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 760px) {
    .card:nth-child(n) {
      transform: none;
    }
  }
</style>
