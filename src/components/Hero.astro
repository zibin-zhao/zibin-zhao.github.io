---
import { profile } from '../data/profile';
import T from './T.astro';
---
<section class="hero" id="top" aria-labelledby="hero-name">
  <span class="collab"><T en={profile.status.en} zh={profile.status.zh} /></span>
  <h1 class="hero-name" id="hero-name"><span>{profile.firstName}</span><span>{profile.lastName}</span></h1>
  <aside class="formula" aria-hidden="true">f(x) = ∫(CRISPR + AI)dx</aside>
  <article class="hero-specimen">
    <h2><T en={profile.role.en} zh={profile.role.zh} /></h2>
    <p class="hero-thesis"><T en="AIing, caring, learning, and everyday wellbeing." zh="人工智能、关怀、学习与日常健康。" /></p>
    <p><T en={profile.tagline.en} zh={profile.tagline.zh} /></p>
    <div class="specimen-meta"><img src="https://lh3.googleusercontent.com/aida/AP1WRLvnukA4djZtHJYJuWsaZFrOqcFIe7eDBqp2l-uqnngfE35Yu431xhsySJ-xfgYyVQpaAMK1jT2Lkh-kvlBh_QPfNZLqVojrX1XVhONFJ3MOsOx3C9PFRlBaRaRNX0DN_STRU5g-EOqzWfCuhBic6SUNgFWepL1jIqgVZub30ZLjxvf58xtk6Jz7stroLGL-AGASWPw18JxYw-H1jSzVLIN_JIYN4LKF9IIe3ltrt9PjfLEKRKro_y7OEuk" alt="Small illustrated specimen cart" width="64" height="64" fetchpriority="high" /><span>v1.0.4 // Active</span></div>
  </article>
  <a class="scroll-cue" href="#about"><T en="Scroll for updates ↓" zh="向下查看更新 ↓" /></a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto minmax(460px, 1fr) auto;
    align-items: center;
    gap: 20px;
    overflow: clip;
    border-bottom: var(--stroke);
    padding: clamp(112px, 15vh, 160px) var(--page-pad) 40px;
  }

  .collab {
    z-index: 3;
    grid-column: 8 / 11;
    justify-self: center;
    border: var(--stroke);
    background: var(--green);
    box-shadow: var(--shadow-control);
    padding: 10px 14px;
    font: 500 clamp(9px, 1vw, 12px)/1.2 var(--font-note);
    letter-spacing: .04em;
    text-transform: uppercase;
    transform: rotate(7deg);
  }

  .hero-name {
    z-index: 1;
    grid-column: 1 / 9;
    grid-row: 2;
    align-self: center;
    font-family: var(--font-display);
    font-size: clamp(86px, 16vw, 236px);
    font-weight: 400;
    letter-spacing: -.055em;
    line-height: .72;
    text-transform: uppercase;
    transform: rotate(-2deg);
  }

  .hero-name span { display: block; }
  .hero-name span:last-child {
    color: var(--green);
    -webkit-text-stroke: 2px var(--ink);
    transform: translateX(clamp(18px, 4vw, 60px));
  }

  .formula {
    grid-column: 2 / 7;
    grid-row: 3;
    justify-self: center;
    border-bottom: 1px solid var(--ink);
    font: 500 clamp(10px, 1.1vw, 13px)/1.4 var(--font-note);
    transform: rotate(-3deg);
  }

  .hero-specimen {
    position: relative;
    z-index: 2;
    grid-column: 7 / 12;
    grid-row: 2;
    align-self: end;
    width: min(100%, 450px);
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-card);
    padding: clamp(22px, 3vw, 38px);
    transform: rotate(2deg);
  }

  .hero-specimen::before {
    position: absolute;
    top: -14px;
    left: 38%;
    width: 88px;
    height: 24px;
    background: color-mix(in srgb, var(--orange) 72%, transparent);
    content: '';
    transform: rotate(-4deg);
  }

  .hero-specimen h2 {
    max-width: 11ch;
    font-family: var(--font-body);
    font-size: clamp(30px, 4vw, 52px);
    letter-spacing: -.045em;
    line-height: .92;
  }

  .hero-specimen > p {
    margin-top: 18px;
    color: var(--muted);
    font-size: clamp(12px, 1.25vw, 15px);
    line-height: 1.55;
  }

  .hero-specimen .hero-thesis {
    color: var(--ink);
    font-size: clamp(15px, 1.7vw, 20px);
    font-weight: 700;
    line-height: 1.25;
  }

  .specimen-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 24px;
    border-top: 1px dashed var(--outline);
    padding-top: 16px;
    font: 500 10px/1.3 var(--font-note);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .specimen-meta img {
    display: block;
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    border: 1px solid var(--ink);
    background: var(--green);
    color: var(--ink);
    object-fit: cover;
    font: 500 8px/1.1 var(--font-note);
  }

  .scroll-cue {
    grid-column: 10 / 13;
    grid-row: 3;
    justify-self: end;
    border: 1px solid var(--ink);
    background: var(--orange);
    box-shadow: var(--shadow-control);
    padding: 9px 12px;
    font: 500 10px/1.2 var(--font-note);
    text-transform: uppercase;
    transform: rotate(2deg);
    transition: transform var(--motion-fast) var(--ease-press), box-shadow var(--motion-fast) var(--ease-press);
  }

  .scroll-cue:hover {
    box-shadow: 1px 1px 0 var(--ink);
    transform: translate(2px, 2px) rotate(0);
  }

  @media (max-width: 780px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 32px;
      padding: 118px 20px 60px;
    }

    .collab,
    .hero-name,
    .formula,
    .hero-specimen,
    .scroll-cue {
      grid-column: 1;
      grid-row: auto;
    }

    .collab { justify-self: end; margin-right: 6vw; }
    .hero-name { font-size: clamp(82px, 27vw, 150px); }
    .formula { justify-self: end; margin-right: 4vw; }
    .hero-specimen { justify-self: center; width: min(88vw, 450px); }
    .scroll-cue { justify-self: end; }
  }

  @media (max-width: 440px) {
    .hero-name { font-size: clamp(76px, 26vw, 116px); }
    .hero-specimen { width: 94%; padding: 24px; }
  }
</style>
