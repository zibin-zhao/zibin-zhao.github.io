---
import T from './T.astro';
import { profile } from '../data/profile';

interface Props {
  active?: string;
}

const { active } = Astro.props;
const routes = [
  { key: 'about', href: '/about/', en: 'About', zh: '关于', tone: '' },
  { key: 'research', href: '/research/', en: 'Research', zh: '研究', tone: 'green' },
  { key: 'projects', href: '/projects/', en: 'Projects', zh: '项目', tone: '' },
  { key: 'vibe', href: '/#vibe', en: 'Vibe', zh: '随性', tone: 'orange' },
  { key: 'cv', href: '/cv/', en: 'CV', zh: '简历', tone: '' },
  { key: 'contact', href: '/contact/', en: 'Contact', zh: '联系', tone: 'mint' },
];
const socials = profile.socials.slice(0, 3);
const tape = 'molecules ↔ models ↔ small habits ↔ field notes ↔ tools for care ↔ ';
---
<footer class="stitch-footer" aria-label="Site index">
  <div class="footer-socials" role="group" aria-label="Social links rail">
    {socials.map((social, index) => (
      <a class:list={['footer-pill', `social-${index + 1}`]} href={social.href} target="_blank" rel="noopener">
        <span aria-hidden="true">↗</span>{social.label}
      </a>
    ))}
  </div>

  <nav class="footer-routes" aria-label="Portfolio sections">
    {routes.map((route, index) => (
      <span class:list={['route-angle', `route-angle-${index + 1}`]}>
        <a
          class:list={['footer-pill', 'glitch-hover', route.tone]}
          href={route.href}
          aria-current={active === route.key ? 'page' : undefined}
        ><T en={route.en} zh={route.zh} /></a>
      </span>
    ))}
  </nav>

  <div class="footer-decoration" aria-hidden="true">
    <div class="marquee"><span>{tape}{tape}</span></div>
  </div>

  <a class="draw-control" href="/prompts/" aria-label="Open Prompt Archive" aria-current={active === 'prompts' ? 'page' : undefined}>
    <span class="draw-disc" aria-hidden="true">✎</span>
    <span class="draw-label"><T en="Prompts" zh="提示词" /></span>
  </a>
</footer>

<style>
  .stitch-footer {
    position: fixed;
    z-index: 40;
    inset: auto 0 0;
    width: 100%;
    pointer-events: none;
  }

  .footer-socials,
  .footer-routes,
  .draw-control {
    pointer-events: auto;
  }

  .footer-socials {
    position: absolute;
    bottom: calc(32px + env(safe-area-inset-bottom));
    left: var(--page-pad);
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 4px;
    transform: rotate(-1deg);
  }

  .footer-routes {
    position: absolute;
    right: calc(var(--page-pad) + 16px);
    bottom: calc(32px + env(safe-area-inset-bottom));
    display: flex;
    width: min(250px, calc(100vw - 40px));
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .footer-pill {
    --resting-background: var(--surface);
    --resting-shadow: var(--shadow-2);
    --resting-transform: none;
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border: var(--stroke);
    background: var(--resting-background);
    box-shadow: var(--shadow-2);
    font: 500 var(--text-action)/1.2 var(--font-note);
    letter-spacing: var(--tracking-utility);
    white-space: nowrap;
    text-transform: uppercase;
  }

  .footer-pill:hover { background: var(--surface-container); }
  .footer-pill[aria-current='page'] { --resting-background: var(--surface-container); }
  .footer-pill.green { --resting-background: var(--green-bright); }
  .footer-pill.orange { --resting-background: var(--orange); }
  .footer-pill.mint { --resting-background: color-mix(in srgb, var(--green-bright) 60%, var(--surface)); }

  .social-2 { --resting-transform: rotate(2deg); transform: var(--resting-transform); }
  .social-3 { --resting-transform: rotate(-1deg); transform: var(--resting-transform); }
  .route-angle { display: inline-flex; }
  .route-angle-2 { transform: rotate(-2deg); }
  .route-angle-3 { transform: rotate(2deg); }
  .route-angle-6 { transform: rotate(-1deg); }

  .footer-decoration {
    overflow: hidden;
    width: 100%;
    border-top: 2px solid var(--ink);
    background: var(--ink);
    color: var(--surface);
    pointer-events: none;
    transform: rotate(1deg) scale(1.05);
    transform-origin: bottom;
  }

  .marquee {
    overflow: hidden;
    padding: 8px 0 calc(8px + env(safe-area-inset-bottom));
    font: 500 11px/1.2 var(--font-note);
    letter-spacing: .1em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .marquee span {
    display: inline-block;
    min-width: max-content;
    padding-left: 100%;
  }

  .draw-control {
    --resting-shadow: none;
    --resting-transform: rotate(-12deg);
    position: absolute;
    z-index: 50;
    right: 0;
    bottom: calc(45px + env(safe-area-inset-bottom));
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    color: #ef4444;
  }

  .draw-disc {
    display: inline-flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 2px solid #ef4444;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 2px 2px 0 #ef4444;
    font: 500 23px/1 var(--font-note);
  }

  .draw-label { display: none; }

  @media (max-width: 700px) {
    .stitch-footer {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px;
      overflow: clip;
      padding: 16px 12px 0;
      pointer-events: auto;
    }

    .footer-socials,
    .footer-routes {
      position: static;
      display: flex;
      width: 100%;
      align-items: center;
      flex-flow: row wrap;
      justify-content: flex-start;
      gap: 6px;
      overflow: visible;
      padding: 0;
      transform: none;
    }

    .footer-socials { grid-column: 1 / -1; }
    .footer-routes { grid-column: 1; }

    .footer-pill {
      flex: 0 0 auto;
      padding-inline: 8px;
      font-size: var(--text-action);
    }

    .route-angle { flex: 0 0 auto; }
    .draw-control {
      position: static;
      grid-column: 2;
      grid-row: 2;
      display: inline-flex;
      width: auto;
      min-width: 44px;
      height: 44px;
      align-items: center;
      gap: 8px;
      transform: none;
    }
    .draw-label {
      display: inline;
      font: 500 var(--text-action)/1.2 var(--font-note);
      letter-spacing: var(--tracking-utility);
      text-transform: uppercase;
    }
    .footer-decoration {
      grid-column: 1 / -1;
      width: calc(100% + 24px);
      margin-inline: -12px;
      transform: rotate(1deg) scale(1.02);
    }
    .marquee { padding-bottom: calc(8px + env(safe-area-inset-bottom)); }
  }

  @media (min-width: 701px) and (max-width: 960px) {
    .footer-socials,
    .footer-routes {
      display: flex;
      width: max-content;
      align-items: center;
      flex-flow: row nowrap;
      justify-content: flex-start;
      gap: 4px;
      overflow: visible;
      padding: 3px 4px 5px;
      transform: none;
    }

    .footer-socials {
      bottom: calc(32px + env(safe-area-inset-bottom));
      left: 24px;
      max-width: calc(100vw - 100px);
    }

    .footer-routes {
      right: 24px;
      bottom: calc(96px + env(safe-area-inset-bottom));
      max-width: calc(100vw - 48px);
    }

    .footer-pill {
      flex: 0 0 auto;
      padding: 5px 8px;
      font-size: var(--text-action);
    }

    .route-angle { flex: 0 0 auto; }
    .draw-control { right: 4px; }
  }
</style>
