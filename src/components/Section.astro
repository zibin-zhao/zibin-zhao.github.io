---
import T from './T.astro';
const { id, num, label, labelZh, variant = 'note' } = Astro.props;
---
<section id={id} class:list={['reveal', 'chapter', `chapter--${variant}`]}>
  <header class="chapter-heading">
    <span class="chapter-number" aria-hidden="true">FILE {num}</span>
    <h2 class="chapter-title"><T en={label} zh={labelZh ?? label} /></h2>
  </header>
  <div class="chapter-content"><slot /></div>
</section>
<style>
  .chapter {
    position: relative;
    min-width: 0;
  }

  .chapter + :global(.chapter) {
    border-top: 2px dashed var(--outline);
  }

  .chapter-heading {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    margin: -1px;
    padding: 0;
    border: 0;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .chapter-number {
    color: var(--muted);
    font: 500 10px/1.3 var(--font-note);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .chapter-title {
    font: 400 clamp(22px, 3.5vw, 34px)/1 var(--font-display);
    letter-spacing: .01em;
    text-transform: uppercase;
  }

  .chapter-content {
    position: relative;
  }

</style>
