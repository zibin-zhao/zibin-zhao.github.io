---
import type { GithubProject } from '../data/github-projects';
import type { ProjectCover } from '../data/project-media';
import T from './T.astro';

interface Props {
  project: GithubProject;
  image?: ProjectCover;
}

const { project, image } = Astro.props;
---

<article
  class="research-project-card"
  data-research-project={project.name}
  data-featured={project.featured}
>
  {image && (
    <div
      class="research-project-cover-frame"
      style={`--cover-ratio: ${image.width} / ${image.height};`}
    >
      <img
        class="research-project-cover"
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="research-project-body">
    <h3>{project.name}</h3>
    <div class="research-project-descriptions">
      <p class="t-en">{project.description}</p>
      <p class="t-zh">{project.descriptionZh}</p>
    </div>

    <ul class="research-project-stack" aria-label={`${project.name} technologies`}>
      {project.stack.slice(0, 3).map((technology) => <li>{technology}</li>)}
    </ul>

    <div class="research-project-actions">
      <a
        class="research-project-action"
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${project.name} on GitHub (opens in a new tab)`}
      ><T en="GitHub ↗" zh="GitHub ↗" /></a>
      {project.demoUrl && (
        <a
          class="research-project-action research-project-action--demo"
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${project.name} live demo (opens in a new tab)`}
        ><T en="Live demo ↗" zh="在线演示 ↗" /></a>
      )}
    </div>
  </div>
</article>

<style>
  .research-project-card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: var(--stroke);
    background: var(--surface);
    box-shadow: var(--shadow-6);
    color: var(--ink);
  }

  .research-project-card[data-featured='true'] { box-shadow: 7px 7px 0 var(--orange); }

  .research-project-cover-frame {
    width: 100%;
    aspect-ratio: var(--cover-ratio);
    overflow: hidden;
    border-bottom: var(--stroke);
    background: var(--surface-low);
  }

  .research-project-cover {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .research-project-body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    padding: clamp(18px, 3vw, 28px);
  }

  h3 {
    padding-bottom: 12px;
    border-bottom: 2px dashed currentColor;
    font: 400 clamp(26px, 4vw, 40px)/1 var(--font-display);
    overflow-wrap: anywhere;
    text-transform: uppercase;
  }

  .research-project-descriptions {
    max-width: 68ch;
    margin-top: 16px;
    color: var(--muted);
    font-size: var(--text-supporting);
    line-height: 1.55;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .research-project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 18px;
    list-style: none;
  }

  .research-project-stack li {
    padding: 4px 7px;
    border: 1px solid currentColor;
    background: var(--green-bright);
    font: 500 var(--text-meta)/1.25 var(--font-note);
  }

  .research-project-stack li:nth-child(even) { background: var(--blue); }

  .research-project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: 22px;
  }

  .research-project-action {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 9px 12px;
    border: var(--stroke);
    background: var(--ink);
    box-shadow: var(--shadow-2);
    color: var(--surface);
    font: 500 var(--text-action)/1.3 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .research-project-action--demo { background: var(--orange); color: var(--ink); }

  @media (hover: hover) {
    .research-project-action:hover { background: var(--green-bright); color: var(--ink); }
  }

  @media (max-width: 700px) {
    .research-project-body { padding: 18px; }
    .research-project-action { flex: 1 1 136px; }
  }
</style>
