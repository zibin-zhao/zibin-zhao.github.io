---
import T from './T.astro';
const { title, blurb, blurbZh, type, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class="pcard" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener' : undefined}>
  <span class="tag">{type}</span>
  <h4>{title}</h4>
  <p><T en={blurb} zh={blurbZh ?? blurb} /></p>
  {href && <span class="go"><T en="View →" zh="查看 →" /></span>}
</Tag>
<style>
  .pcard{display:block;border:1.5px solid var(--ink);background:var(--paper);box-shadow:var(--shadow-sticker);padding:20px;transition:transform var(--motion-fast) var(--ease-spring),box-shadow var(--motion-fast)}
  .pcard:nth-child(2n){background:var(--blue);transform:rotate(1.2deg)}.pcard:nth-child(3n){background:var(--green-light);transform:rotate(-1deg)}
  a.pcard:hover{transform:translate(-5px,-5px) rotate(-2deg);box-shadow:10px 10px 0 var(--ink)}
  .tag{display:inline-block;border:1px solid var(--ink);padding:3px 8px;color:var(--ink);font:700 10px/1 var(--font-note);text-transform:uppercase}
  .pcard h4{font-family:Georgia,'Times New Roman',serif;font-size:22px;font-weight:500;line-height:1;margin:13px 0 8px}
  .pcard p{color:var(--muted);font-size:13px;line-height:1.5}.go{display:inline-block;margin-top:12px;font:700 11px/1 var(--font-note);text-decoration:underline;text-underline-offset:3px}
  @media(max-width:760px){.pcard:nth-child(n){transform:none}}
</style>
