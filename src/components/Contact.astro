---
import { profile } from '../data/profile';
import T from './T.astro';

const year = new Date().getFullYear();
---

<section id="contact" class="reveal closing-poster">
  <div class="closing-copy">
    <p class="closing-label">06 — <T en="Contact" zh="联系" /></p>
    <h2><T en="Let's make something useful." zh="一起做些真正有用的东西。" /></h2>
    <p class="closing-note">
      <T
        en="Open to collaboration, research chats & opportunities."
        zh="欢迎合作、学术交流与各类机会。"
      />
    </p>
    <a class="email" href={`mailto:${profile.email}`}>
      <span class="email-address">{profile.email}</span><span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="closing-indexes">
    <nav class="footer-index" aria-label="Footer chapters">
      {profile.navLinks.map((link) => (
        <a href={link.href}><T en={link.en} zh={link.zh} /></a>
      ))}
    </nav>

    <div class="social-index" aria-label="Social profiles">
      {profile.socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener">
          {social.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>

  <footer>© {year} Zibin Zhao</footer>
</section>

<style>
  .closing-poster {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(64px, 10vw, 120px) var(--page-pad) clamp(28px, 5vw, 52px);
    border-block: var(--stroke);
    color: var(--paper);
    background: var(--ink);
  }

  .closing-poster::before {
    position: absolute;
    z-index: -1;
    top: clamp(-90px, -8vw, -32px);
    right: clamp(-90px, -6vw, -24px);
    width: clamp(150px, 24vw, 310px);
    aspect-ratio: 1;
    border: 2px solid var(--paper);
    border-radius: 50%;
    background: var(--orange);
    content: '';
  }

  .closing-copy,
  .closing-indexes,
  footer {
    width: min(100%, var(--content-max));
    margin-inline: auto;
  }

  .closing-label {
    color: var(--orange);
    font: 500 13px/1.2 var(--font-note);
    letter-spacing: .05em;
    text-transform: uppercase;
  }

  .closing-poster h2 {
    max-width: 850px;
    margin-top: clamp(20px, 4vw, 42px);
    font: 400 clamp(44px, 8.5vw, 96px)/.98 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
  }

  .closing-note {
    max-width: 60ch;
    margin-top: clamp(24px, 4vw, 38px);
    font-size: clamp(15px, 2vw, 19px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .email {
    display: inline-flex;
    gap: .6em;
    align-items: baseline;
    max-width: 100%;
    margin-top: clamp(18px, 3vw, 30px);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--orange);
    color: var(--paper);
    font: 500 clamp(15px, 2.4vw, 23px)/1.25 var(--font-note);
  }

  .email-address {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .closing-indexes {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(230px, .55fr);
    gap: clamp(34px, 7vw, 88px);
    margin-top: clamp(66px, 10vw, 118px);
    padding-top: clamp(24px, 4vw, 42px);
    border-top: 1px solid var(--green);
  }

  .footer-index {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    align-content: start;
  }

  .footer-index a,
  .social-index a {
    font: 500 12px/1.4 var(--font-note);
    transition: color var(--motion-fast) var(--ease-press);
  }

  .footer-index a:hover,
  .social-index a:hover {
    color: var(--orange);
  }

  .social-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 20px;
  }

  footer {
    margin-top: clamp(42px, 7vw, 76px);
    color: var(--green-bright);
    font: 500 11px/1.4 var(--font-note);
  }

  @media (max-width: 700px) {
    .closing-poster::before {
      opacity: .65;
    }

    .closing-indexes {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 440px) {
    .closing-poster h2 {
      font-size: clamp(40px, 14vw, 58px);
    }

    .social-index {
      grid-template-columns: 1fr;
    }
  }
</style>
