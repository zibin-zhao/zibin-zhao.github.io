---
import { profile } from '../data/profile';
import T from './T.astro';

const year = new Date().getFullYear();
---

<section id="contact" class="reveal contact-record">
  <div class="contact-copy">
    <p class="contact-label">ARCHIVE 06 / CORRESPONDENCE</p>
    <h2><T en="Let's make something useful." zh="一起做些真正有用的东西。" /></h2>
    <p class="contact-note">
      <T
        en="Open to collaboration, research chats & opportunities."
        zh="欢迎合作、学术交流与各类机会。"
      />
    </p>
    <a class="email" href={`mailto:${profile.email}`}>
      <span class="email-address">{profile.email}</span><span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="contact-indexes">
    <nav class="footer-index" aria-label="Footer chapters">
      {profile.navLinks.map((link) => (
        <a href={link.href}><T en={link.en} zh={link.zh} /></a>
      ))}
    </nav>

    <div class="social-index" aria-label="Social profiles">
      {profile.socials.map((social) => (
        <a data-contact-social={social.label} href={social.href} target="_blank" rel="noopener noreferrer">
          {social.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>

  <footer>© {year} Zibin Zhao</footer>
</section>

<style>
  .contact-record {
    position: relative;
    min-width: 0;
    padding: clamp(22px, 4vw, 38px);
    border: var(--stroke);
    background: var(--surface);
    box-shadow: var(--shadow-6);
    transform: rotate(.5deg);
  }

  .contact-record::before {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 54px;
    height: 18px;
    border: var(--stroke);
    background: repeating-linear-gradient(90deg, var(--green) 0 4px, var(--surface) 4px 8px);
    content: '';
  }

  .contact-copy {
    padding-bottom: clamp(28px, 5vw, 48px);
    border-bottom: 2px dashed var(--outline);
  }

  .contact-label {
    padding-right: 70px;
    color: var(--muted);
    font: 500 10px/1.4 var(--font-note);
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .contact-record h2 {
    max-width: 760px;
    margin-top: clamp(18px, 3vw, 30px);
    font: 400 clamp(38px, 7vw, 72px)/.98 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: balance;
    text-transform: uppercase;
  }

  .contact-note {
    max-width: 60ch;
    margin-top: 20px;
    color: var(--muted);
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .email {
    display: inline-flex;
    min-height: 40px;
    gap: .6em;
    align-items: center;
    max-width: 100%;
    margin-top: 24px;
    padding: 10px 12px;
    border: var(--stroke);
    color: var(--ink);
    background: var(--orange);
    box-shadow: var(--shadow-4);
    font: 500 clamp(13px, 2vw, 18px)/1.25 var(--font-note);
  }

  .email-address {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact-indexes {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(230px, .55fr);
    gap: clamp(28px, 5vw, 56px);
    padding-top: clamp(28px, 5vw, 48px);
  }

  .footer-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 18px;
  }

  .footer-index a,
  .social-index a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 2px dashed var(--outline);
    font: 500 11px/1.4 var(--font-note);
    transition: background-color var(--motion-fast) var(--ease-press);
  }

  .footer-index a:hover,
  .social-index a:hover {
    background: var(--green-bright);
  }

  .social-index {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px 18px;
  }

  footer {
    margin-top: clamp(30px, 5vw, 52px);
    padding-top: 12px;
    border-top: 2px dashed var(--outline);
    color: var(--muted);
    font: 500 11px/1.4 var(--font-note);
  }

  @media (max-width: 700px) {
    .contact-record {
      box-shadow: var(--shadow-4);
      transform: none;
    }

    .contact-indexes {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 440px) {
    .contact-record h2 {
      font-size: clamp(40px, 14vw, 58px);
    }

    .footer-index,
    .social-index {
      grid-template-columns: 1fr;
    }
  }
</style>
