---
import { profile } from '../data/profile';
import T from './T.astro';
const year = new Date().getFullYear();
---
<section id="contact" class="reveal contact">
  <div class="label">06 — <T en="Contact" zh="联系" /></div>
  <h2 class="big"><T en="Let's talk." zh="聊聊吧。" /></h2>
  <p><T en="Open to collaboration, research chats & opportunities." zh="欢迎合作、学术交流与各类机会。" /></p>
  <div class="row">
    <a href={`mailto:${profile.email}`}>✉ <T en="Email" zh="邮箱" /></a>
    {profile.socials.map(s => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
  </div>
  <footer>© {year} Zibin Zhao</footer>
</section>
<style>
  .contact{position:relative;overflow:hidden;border:2px solid var(--ink);text-align:center;background:var(--green);color:var(--paper);padding:90px 50px 50px;margin:0 var(--gap)}
  .contact::before{position:absolute;top:-90px;left:-80px;width:230px;height:230px;border:1.5px solid var(--ink);border-radius:50%;background:var(--blue);content:""}
  .contact .label{position:relative;color:var(--paper);font-family:var(--font-note)}
  .contact h2{position:relative;font-family:Georgia,'Times New Roman',serif;font-size:clamp(42px,7vw,78px);font-weight:500;margin:10px 0}
  .contact p{position:relative;color:var(--paper);font-size:14px}
  .row{position:relative;display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:20px}.row a{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--ink);background:var(--paper);color:var(--ink);padding:8px 12px;font:700 11px/1 var(--font-note)}footer{position:relative;margin-top:34px;color:var(--paper);font:11px/1 var(--font-note)}
</style>
