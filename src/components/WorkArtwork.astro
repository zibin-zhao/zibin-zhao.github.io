---
interface Props {
  kind: string;
  variant?: 'front' | 'back';
}

const { kind, variant = 'front' } = Astro.props;

const palettes: Record<string, [string, string, string]> = {
  'nature-biotech-cas12a': ['#e9c8f2', '#514b30', '#f6f3ec'],
  casmd: ['#294fe5', '#f6f3ec', '#dfc458'],
  dlselex: ['#dfc458', '#ad3b26', '#f6f3ec'],
  medit: ['#e9c8f2', '#514b30', '#f6f3ec'],
  tempo: ['#ad3b26', '#dfc458', '#f6f3ec'],
  singularity: ['#222831', '#e9c8f2', '#dfc458'],
  yaos: ['#514b30', '#e9c8f2', '#dfc458'],
  'ecg-patch-12lead': ['#294fe5', '#f6f3ec', '#dfc458'],
  'dna-hydrogel-oect': ['#dfc458', '#514b30', '#ad3b26'],
};
const [paper, ink, accent] = palettes[kind] ?? palettes['nature-biotech-cas12a'];
const turns = Array.from({ length: 24 }, (_, i) => i * 15);
const patternCells = Array.from({ length: 56 }, (_, i) => ({
  x: (i % 7) * 76 - 28 + (Math.floor(i / 7) % 2) * 38,
  y: Math.floor(i / 7) * 76 - 6,
  angle: i % 2 === 0 ? 0 : 90,
}));
const stars = Array.from({ length: 45 }, (_, i) => ({
  x: ((i * 139 + 31) % 354) + 23,
  y: ((i * 197 + 41) % 474) + 23,
  size: i % 7 === 0 ? 5 : i % 3 === 0 ? 2.5 : 1.2,
}));
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 520"
  preserveAspectRatio="xMidYMid slice"
  class:list={['work-artwork', `work-artwork--${variant}`]}
  aria-hidden="true"
  focusable="false"
>
  <rect width="400" height="520" fill={paper}></rect>
  {
    variant === 'back' ? (
      <g fill="none" stroke={ink} stroke-width="6" stroke-linecap="round">
        {patternCells.map(({ x, y, angle }) => (
          <g transform={`translate(${x} ${y}) rotate(${angle})`}>
            {kind === 'nature-biotech-cas12a' && (
              <>
                <path d="M-28-28C30-28-30 28 28 28M28-28C-30-28 30 28-28 28" />
                <circle r="5" fill={accent} stroke="none" />
              </>
            )}
            {kind === 'casmd' && (
              <>
                <ellipse rx="31" ry="13" transform="rotate(-35)" stroke-width="3" />
                <ellipse rx="31" ry="13" transform="rotate(35)" stroke-width="3" />
                <circle r="7" fill={accent} stroke="none" />
              </>
            )}
            {kind === 'dlselex' && (
              <path d="M0 31V1C0-20-27-9-27-31M0 1C0-20 27-9 27-31M-15 31V15M15 31V15" />
            )}
            {kind === 'medit' && (
              <>
                <circle r="29" stroke-width="3" />
                <circle r="19" stroke-width="3" />
                <circle r="9" stroke-width="3" />
              </>
            )}
            {kind === 'tempo' && (
              <>
                <path d="M0-29V-17M0 29V17M-29 0H-17M29 0H17M-21-21L-12-12M21 21L12 12M21-21L12-12M-21 21L-12 12" />
                <circle r="5" fill={ink} stroke="none" />
              </>
            )}
            {kind === 'singularity' && (
              <path
                d="M0-31C3-7 7-3 31 0C7 3 3 7 0 31C-3 7-7 3-31 0C-7-3-3-7 0-31Z"
                fill={ink}
                stroke="none"
              />
            )}
            {kind === 'yaos' && (
              <>
                <path
                  d="M0 0C-34 0-34-34 0-29C34-34 34 0 0 0C34 0 34 34 0 29C-34 34-34 0 0 0Z"
                  fill={ink}
                  stroke="none"
                />
                <circle r="5" fill={accent} stroke="none" />
              </>
            )}
            {kind === 'ecg-patch-12lead' && (
              <path
                d="M-35 4H-17L-8-17L3 27L14-6L20 4H35"
                stroke-width="4"
                stroke-linejoin="round"
              />
            )}
            {kind === 'dna-hydrogel-oect' && (
              <>
                <rect x="-27" y="-27" width="54" height="54" rx="21" stroke-width="9" />
                <circle r="5" fill={accent} stroke="none" />
              </>
            )}
          </g>
        ))}
      </g>
    ) : (
      <>
        {kind === 'nature-biotech-cas12a' && (
          <g fill="none" stroke-linecap="round">
            <path d="M89 105C327 106 76 414 311 414" stroke={ink} stroke-width="58" />
            <path d="M311 105C77 106 324 414 89 414" stroke={paper} stroke-width="76" />
            <path d="M311 105C77 106 324 414 89 414" stroke={ink} stroke-width="58" />
            <path
              d="M97 105C215 105 186 196 196 214M304 414C194 414 215 326 204 305"
              stroke={accent}
              stroke-width="4"
            />
            <circle cx="312" cy="105" r="9" fill={accent} stroke="none" />
            <circle cx="89" cy="414" r="9" fill={accent} stroke="none" />
          </g>
        )}
        {kind === 'casmd' && (
          <g transform="translate(200 260)">
            {[0, 60, 120].map((angle) => (
              <ellipse
                rx="168"
                ry="69"
                transform={`rotate(${angle})`}
                fill="none"
                stroke={ink}
                stroke-width="4"
              />
            ))}
            <circle r="42" fill={ink} />
            <circle cx="-20" cy="-21" r="10" fill={paper} />
            <circle cx="147" cy="35" r="15" fill={accent} />
            <circle cx="-30" cy="-154" r="10" fill={accent} />
            <circle cx="-117" cy="110" r="19" fill={ink} />
            <path
              d="M-175-189H-154M-164-200V-178M139 192H157M148 183V201"
              fill="none"
              stroke={ink}
              stroke-width="2"
            />
          </g>
        )}
        {kind === 'dlselex' && (
          <g fill="none" stroke={ink} stroke-width="19" stroke-linecap="round">
            <path d="M200 422V284C200 177 75 254 75 119M200 284C200 177 325 254 325 119" />
            <path d="M200 365C200 275 113 331 113 230M200 365C200 275 287 331 287 230" />
            <path d="M200 260V105" />
            <circle cx="75" cy="106" r="23" fill={ink} stroke="none" />
            <circle cx="200" cy="106" r="23" fill={ink} stroke="none" />
            <circle cx="325" cy="106" r="23" fill={ink} stroke="none" />
            <circle cx="113" cy="228" r="15" fill={accent} stroke="none" />
            <circle cx="287" cy="228" r="15" fill={accent} stroke="none" />
          </g>
        )}
        {kind === 'medit' && (
          <>
            <circle cx="200" cy="182" r="36" fill={ink} />
            <g fill="none" stroke={ink} stroke-width="3.5">
              {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
                <ellipse cx="200" cy={279 + i * 7} rx={33 + i * 23} ry={12 + i * 9} />
              ))}
            </g>
            <path d="M200 83V116M183 100H217" stroke={ink} stroke-width="2" />
            <circle cx="200" cy="425" r="4" fill={ink} />
          </>
        )}
        {kind === 'tempo' && (
          <g transform="translate(200 260)">
            {turns.map((angle, index) => (
              <path
                d={index % 3 === 0 ? 'M0-90V-167' : 'M0-117V-161'}
                transform={`rotate(${angle})`}
                stroke={ink}
                stroke-width={index % 3 === 0 ? 14 : 5}
              />
            ))}
            <path
              d="M0-75V0L57 33"
              fill="none"
              stroke={accent}
              stroke-width="11"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle r="13" fill={accent} />
            <circle r="186" fill="none" stroke={ink} stroke-width="1.5" />
          </g>
        )}
        {kind === 'singularity' && (
          <>
            {stars.map(({ x, y, size }) => (
              <circle cx={x} cy={y} r={size} fill={ink} />
            ))}
            <g transform="translate(200 260)">
              <ellipse
                rx="184"
                ry="83"
                transform="rotate(-32)"
                fill="none"
                stroke={ink}
                stroke-width="2"
              />
              <circle r="108" fill={paper} stroke={ink} stroke-width="2" />
              <circle r="82" fill="none" stroke={ink} stroke-width="1" />
              <path
                d="M0-68C8-15 15-8 68 0C15 8 8 15 0 68C-8 15-15 8-68 0C-15-8-8-15 0-68Z"
                fill={ink}
              />
              <circle cx="151" cy="-86" r="13" fill={accent} />
            </g>
          </>
        )}
        {kind === 'yaos' && (
          <g transform="translate(200 260)">
            {[0, 60, 120, 180, 240, 300].map((angle) => (
              <g transform={`rotate(${angle})`}>
                <path d="M0-9C-80-71-76-158 0-184C76-158 80-71 0-9Z" fill={ink} />
                <path d="M0-34V-153" stroke={paper} stroke-width="2" />
              </g>
            ))}
            <circle r="32" fill={paper} />
            <circle r="20" fill={accent} />
          </g>
        )}
        {kind === 'ecg-patch-12lead' && (
          <>
            <g fill="none" stroke={ink} stroke-width="1" opacity=".22">
              {[80, 120, 160, 200, 240, 280, 320, 360, 400, 440].map((y) => (
                <path d={`M40 ${y}H360`} />
              ))}
              {[40, 80, 120, 160, 200, 240, 280, 320, 360].map((x) => (
                <path d={`M${x} 80V440`} />
              ))}
            </g>
            <path
              d="M33 276H103L128 230L168 352L211 149L249 302L271 276H367"
              fill="none"
              stroke={ink}
              stroke-width="12"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="211" cy="149" r="14" fill={accent} />
            <circle cx="200" cy="415" r="5" fill={accent} />
          </>
        )}
        {kind === 'dna-hydrogel-oect' && (
          <g transform="translate(200 260) rotate(-45)">
            {[-78, 0, 78].map((x) =>
              [-78, 0, 78].map((y) => (
                <rect
                  x={x - 50}
                  y={y - 50}
                  width="100"
                  height="100"
                  rx="38"
                  fill="none"
                  stroke={ink}
                  stroke-width="17"
                />
              )),
            )}
            {[-39, 39].map((x) =>
              [-39, 39].map((y) => <circle cx={x} cy={y} r="10" fill={accent} />),
            )}
          </g>
        )}
      </>
    )
  }
</svg>

<style>
  .work-artwork {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
</style>
