---
import T from './T.astro';
---

<section
  class="sticker-constellation"
  data-sticker-constellation
  aria-label="Personal interests and creative practices / 个人兴趣与创作日常"
>
  <figure
    class="sticker-figure sticker-figure--dna"
    style="--sticker-depth: .34; --sticker-angle: -2.2deg; --sticker-duration: 8.2s; --sticker-delay: -1.4s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/dna-ai.png" width="768" height="768" loading="lazy" decoding="async" alt="DNA helix flowing into a glowing artificial intelligence chip" />
        </div>
      </div>
    </div>
    <figcaption><T en="DNA + AI" zh="DNA 与 AI" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--instruments"
    style="--sticker-depth: .85; --sticker-angle: 2deg; --sticker-duration: 7.2s; --sticker-delay: -.8s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/instruments.png" width="768" height="768" loading="lazy" decoding="async" alt="Violin, piano keys, guitar, and drums arranged as musical instruments" />
        </div>
      </div>
    </div>
    <figcaption><T en="Violin · piano · guitar · drums" zh="小提琴 · 钢琴 · 吉他 · 架子鼓" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--calligraphy"
    style="--sticker-depth: .55; --sticker-angle: -1.3deg; --sticker-duration: 8.8s; --sticker-delay: -2.3s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/calligraphy.png" width="768" height="768" loading="lazy" decoding="async" alt="Ink brush making expressive Chinese calligraphy strokes" />
        </div>
      </div>
    </div>
    <figcaption><T en="Chinese calligraphy" zh="中国书法" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--reading"
    style="--sticker-depth: .72; --sticker-angle: 1.2deg; --sticker-duration: 7.8s; --sticker-delay: -3.5s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/reading.png" width="768" height="768" loading="lazy" decoding="async" alt="Open book with handwritten notes for a quiet reading session" />
        </div>
      </div>
    </div>
    <figcaption><T en="Reading, underlining, returning" zh="阅读、划线、重读" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--psychology"
    style="--sticker-depth: .43; --sticker-angle: -2.4deg; --sticker-duration: 9.2s; --sticker-delay: -4.1s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/psychology.png" width="768" height="768" loading="lazy" decoding="async" alt="Layered profile and thought shapes representing psychology" />
        </div>
      </div>
    </div>
    <figcaption><T en="Psychology & the mind" zh="心理学与心灵" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--meditation"
    style="--sticker-depth: .62; --sticker-angle: 1.8deg; --sticker-duration: 8.4s; --sticker-delay: -1.8s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/meditation.png" width="768" height="768" loading="lazy" decoding="async" alt="Calm seated figure practicing meditation beneath a soft halo" />
        </div>
      </div>
    </div>
    <figcaption><T en="Meditation practice" zh="冥想练习" /></figcaption>
  </figure>

  <figure
    class="sticker-figure sticker-figure--coding"
    style="--sticker-depth: .95; --sticker-angle: -.8deg; --sticker-duration: 7.4s; --sticker-delay: -2.8s;"
  >
    <div class="sticker-reveal">
      <div class="sticker-parallax">
        <div class="sticker-drift">
          <img class="sticker-image" src="/stickers/coding-lab.png" width="768" height="768" loading="lazy" decoding="async" alt="Laptop glowing with code beside playful late-night lab notes" />
        </div>
      </div>
    </div>
    <figcaption><T en="Late-night coding" zh="深夜编程" /></figcaption>
  </figure>
</section>

<script>import '../scripts/sticker-motion.ts';</script>

<style>
  .sticker-constellation {
    --sticker-scroll: 0px;
    position: relative;
    display: grid;
    overflow: clip;
    grid-template-areas:
      'dna dna dna instruments instruments instruments instruments calligraphy calligraphy calligraphy . .'
      '. reading reading reading psychology psychology psychology psychology meditation meditation meditation .'
      '. . coding coding coding coding coding . . . . .';
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    gap: clamp(18px, 2.7vw, 32px);
    margin: clamp(72px, 9vw, 104px) 2% 0;
    padding: clamp(28px, 4vw, 44px) clamp(12px, 2.2vw, 24px) 34px;
    border-block: 1px dashed var(--outline);
    background-image: radial-gradient(circle, var(--grid-line) 1.2px, transparent 1.4px);
    background-position: 10px 10px;
    background-size: var(--grid-size) var(--grid-size);
    isolation: isolate;
  }

  .sticker-figure {
    min-width: 0;
    margin: 0;
    justify-self: center;
  }

  .sticker-figure--dna { grid-area: dna; width: 92%; }
  .sticker-figure--instruments { grid-area: instruments; width: 96%; }
  .sticker-figure--calligraphy { grid-area: calligraphy; width: 88%; }
  .sticker-figure--reading { grid-area: reading; width: 84%; }
  .sticker-figure--psychology { grid-area: psychology; width: 90%; }
  .sticker-figure--meditation { grid-area: meditation; width: 86%; }
  .sticker-figure--coding { grid-area: coding; width: 82%; }

  .sticker-reveal,
  .sticker-parallax,
  .sticker-drift {
    width: 100%;
  }

  .sticker-image {
    display: block;
    width: 100%;
    height: auto;
    transition: filter 180ms ease, transform 180ms ease;
  }

  figcaption {
    width: fit-content;
    max-width: calc(100% - 8px);
    margin: 18px auto 0;
    padding: 5px 8px;
    border: 1px solid var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    color: var(--ink);
    font: 600 clamp(.625rem, 1.25vw, .75rem)/1.35 var(--font-note);
    letter-spacing: .01em;
    text-align: center;
    text-wrap: balance;
  }

  @media (min-width: 701px) and (max-width: 960px) {
    .sticker-constellation {
      grid-template-areas:
        'dna dna instruments instruments'
        'calligraphy reading reading meditation'
        'psychology psychology coding coding';
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px 18px;
      margin-inline: 0;
      padding-inline: 16px;
    }

    .sticker-figure--calligraphy,
    .sticker-figure--meditation { width: 100%; }
    .sticker-figure--reading { width: 88%; }
    .sticker-figure--coding { width: 78%; }
  }

  @media (max-width: 700px) {
    .sticker-constellation {
      grid-template-areas:
        'dna instruments'
        'calligraphy reading'
        'psychology meditation'
        'coding coding';
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 10px;
      margin: 64px 0 0;
      padding: 24px 8px 28px;
      background-position: 6px 6px;
      background-size: 16px 16px;
    }

    .sticker-figure--dna,
    .sticker-figure--instruments,
    .sticker-figure--calligraphy,
    .sticker-figure--reading,
    .sticker-figure--psychology,
    .sticker-figure--meditation { width: 96%; }
    .sticker-figure--coding { width: 72%; }
  }

  @media (max-width: 360px) {
    .sticker-constellation { gap: 16px 8px; padding-inline: 6px; }
    figcaption { max-width: 100%; padding-inline: 5px; font-size: .625rem; }
  }
</style>
