---
import { getCollection } from 'astro:content';
import { HOME_VIBE_TITLES, selectByTitles } from '../data/home';
import { profile } from '../data/profile';
import StitchVibeCard from './StitchVibeCard.astro';
import T from './T.astro';

const vibeEntries = await getCollection('vibe');
const selected = selectByTitles(vibeEntries.map((entry) => entry.data), HOME_VIBE_TITLES);
const [singularity, medit, yaos, zen] = selected;
const singularityImage = '/stitch/singularity.png';
---

<section class="stitch-vibe" id="vibe" aria-labelledby="vibe-title">
  <h2 id="vibe-title"><T en="Vibe" zh="随性实验" /></h2>
  <aside class="field-note">
    <strong><T en="After hours" zh="研究之外" /></strong>
    <T en="Small experiments where code meets curiosity, calm, and play." zh="让代码与好奇心、平静和玩心相遇的小实验。" />
  </aside>

  <div class="vibe-mosaic">
    <div class="fade-slot animate-fade-up-1" data-vibe-slot="singularity">
      <StitchVibeCard item={singularity} role="singularity" image={singularityImage} dark />
    </div>
    <div class="fade-slot animate-fade-up-2" data-vibe-slot="medit">
      <StitchVibeCard item={medit} role="medit" />
    </div>
    <div class="vibe-lower animate-fade-up-3">
      <StitchVibeCard item={yaos} role="yaos" />
      <StitchVibeCard item={zen} role="zen" />
    </div>
  </div>

  <div class="collaboration-close">
    <p><T en="Curious about molecules, models, music—or the mind?" zh="想聊分子、模型、音乐，或心灵？" /></p>
    <a class="btn-primary" href={`mailto:${profile.email}`}><T en="Start a conversation ↗" zh="开始聊聊 ↗" /></a>
  </div>
</section>

<style is:global>
  .stitch-vibe {
    position: relative;
    z-index: 20;
    width: min(var(--canvas-max), calc(100% - (2 * var(--page-pad))));
    margin: 0 auto 96px;
    padding-top: 56px;
    scroll-margin-top: 96px;
  }

  .stitch-vibe > h2 {
    position: absolute;
    z-index: 30;
    top: 0;
    right: -8px;
    padding: 10px 16px;
    border: var(--stroke);
    background: var(--orange);
    box-shadow: var(--shadow-4);
    color: var(--ink);
    font: 400 clamp(28px, 4.7vw, 48px)/1 var(--font-display);
    text-transform: uppercase;
    transform: rotate(-1deg);
  }

  .field-note {
    position: relative;
    z-index: 10;
    display: block;
    width: min(58%, 520px);
    margin: 0 0 40px;
    padding: 10px 14px;
    border: var(--stroke);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    font: 500 var(--text-meta)/1.5 var(--font-note);
    transform: rotate(1deg);
  }

  .field-note strong {
    display: block;
    margin-bottom: 7px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--ink);
    font-size: var(--text-meta);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  .vibe-mosaic {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px;
  }

  .vibe-mosaic > .fade-slot { position: relative; width: 100%; min-width: 0; }

  [data-vibe-slot='singularity'] { z-index: 30; grid-column: span 7; }
  [data-vibe-slot='medit'] { z-index: 40; grid-column: span 5; margin-top: 72px; margin-left: auto; }

  .vibe-lower {
    position: relative;
    z-index: 30;
    display: flex;
    grid-column: 1 / -1;
    justify-content: center;
    gap: 24px;
    margin-top: 40px;
  }

  .vibe-lower > .vibe-card { flex: 1; max-width: 440px; }

  .vibe-card--singularity { --resting-transform: rotate(-2deg); }
  .vibe-card--medit { --resting-transform: rotate(3deg); }
  .vibe-card--yaos { --resting-transform: rotate(-1deg); }
  .vibe-card--zen { --resting-transform: rotate(2deg); }

  .collaboration-close {
    display: flex;
    max-width: 820px;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 48px auto 0;
    padding: 20px 22px;
    border: var(--stroke);
    background: var(--orange);
    box-shadow: var(--shadow-4);
    transform: rotate(.8deg);
  }

  .collaboration-close p {
    max-width: 32ch;
    font: 400 clamp(22px, 3vw, 32px)/1.15 var(--font-display);
    text-wrap: balance;
  }

  .collaboration-close a {
    --resting-shadow: var(--shadow-4);
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    padding: 10px 14px;
    border: var(--stroke);
    background: var(--surface);
    font: 500 var(--text-action)/1.4 var(--font-note);
    letter-spacing: var(--tracking-utility);
    text-transform: uppercase;
  }

  @media (max-width: 700px) {
    .stitch-vibe {
      width: min(100% - 36px, 440px);
      margin-bottom: 72px;
      padding-top: 76px;
      scroll-margin-top: 88px;
    }

    .stitch-vibe > h2 {
      right: -4px;
      max-width: calc(100% + 4px);
      padding: 9px 12px;
      font-size: clamp(27px, 9.4vw, 38px);
    }

    .field-note {
      width: 86%;
      margin-bottom: 26px;
      padding: 9px 11px;
      font-size: var(--text-meta);
    }

    .vibe-mosaic {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding: 0 3px 10px;
    }

    .vibe-mosaic > .fade-slot,
    .vibe-lower { width: 100%; margin-left: 0; }
    [data-vibe-slot='singularity'] { z-index: 30; margin-top: 0; }
    [data-vibe-slot='medit'] { z-index: 40; margin-top: -18px; }

    .vibe-lower {
      flex-direction: column;
      gap: 0;
      margin-top: 16px;
    }

    .vibe-lower > .vibe-card { max-width: none; }
    .vibe-lower > .vibe-card + .vibe-card { margin-top: -10px; }

    .collaboration-close {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 28px;
      padding: 18px;
    }
    .collaboration-close a { width: 100%; justify-content: center; }
  }

  @media (min-width: 701px) and (max-width: 960px) {
    .stitch-vibe { margin-top: -8px; margin-bottom: 8px; padding-top: 16px; }
    .stitch-vibe > h2 {
      padding: 8px 10px;
      font-size: 31px;
    }
    .field-note {
      width: min(43%, 294px);
      margin-bottom: 25px;
      padding: 10px 12px;
      font-size: var(--text-meta);
    }
    .field-note strong { margin-bottom: 5px; padding-bottom: 3px; font-size: var(--text-meta); }
    .vibe-mosaic { column-gap: 30px; row-gap: 26px; }
    .vibe-mosaic > [data-vibe-slot='singularity'] > .vibe-card { width: 92%; }
    [data-vibe-slot='medit'] { margin-top: 34px; }
    .vibe-lower { gap: 12px; margin-top: 0; }
    .vibe-lower > .vibe-card { flex: 0 1 272px; max-width: 272px; }
    .collaboration-close { margin-top: 36px; }
  }
</style>
