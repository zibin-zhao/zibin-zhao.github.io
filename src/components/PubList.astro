---
import Section from './Section.astro';
import { getCollection } from 'astro:content';
import { sortPubs } from '../data/pubs';
import T from './T.astro';
const entries = await getCollection('publications');
const pubs = sortPubs(entries.map(e => ({ ...e.data })));
---
<Section id="research" num="02" label="Research & Publications" labelZh="研究与论文" variant="folder">
  <h2 class="big"><T en="Selected work" zh="代表性成果" /></h2>
  <ul class="pubs">
    {pubs.map(p => (
      <li class="pub">
        <span class="yr">{p.year}</span>
        <div>
          <h4>{p.title}{p.featured && <span class="star">★</span>}</h4>
          {p.venue && <div class="venue">{p.venue}</div>}
          {p.authors && <div class="auth">{p.authors}</div>}
          {p.links && <div class="links">{Object.entries(p.links).filter(([,v]) => v).map(([k,v]) => <a href={v} target="_blank" rel="noopener">{k.toUpperCase()}</a>)}</div>}
        </div>
      </li>
    ))}
  </ul>
</Section>
<style>
  .pubs{position:relative;list-style:none;margin-top:22px}
  .pub{display:flex;gap:16px;padding:18px 0;border-top:1px solid var(--ink)}
  .pub:last-child{border-bottom:1px solid var(--ink)}
  .yr{min-width:52px;color:var(--green);font:700 12px/1.2 var(--font-note)}
  .pub h4{font-size:16px;font-weight:600;line-height:1.4}.star{color:var(--orange);margin-left:6px}
  .venue{margin-top:3px;color:var(--muted);font-size:12px}.auth{margin-top:3px;color:var(--muted);font:11px/1.4 var(--font-note)}
  .links{display:flex;gap:12px;margin-top:8px;font:700 11px/1 var(--font-note)}.links a{text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
</style>
