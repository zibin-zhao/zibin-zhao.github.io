---
import Section from './Section.astro';
import { getCollection } from 'astro:content';
import { sortPubs } from '../data/pubs';
const entries = await getCollection('publications');
const pubs = sortPubs(entries.map(e => ({ ...e.data })));
---
<Section id="research" num="02" label="Research & Publications" labelZh="研究与论文" variant="folder">
  <ol class="pubs">
    {pubs.map((p, index) => (
      <li class:list={['pub', p.featured ? 'pub--featured' : 'pub--archive']}>
        {p.featured && <span class="pub-index" aria-hidden="true">{index + 1}</span>}
        <div class="pub-meta"><span>{p.year}</span>{p.venue && <span>{p.venue}</span>}</div>
        <h3>{p.title}{p.featured && <span class="star" aria-label="Featured">★</span>}</h3>
        {p.authors && <p class="pub-authors">{p.authors}</p>}
        {p.links && <div class="pub-links">{Object.entries(p.links).filter(([, value]) => value).map(([key, value]) => <a href={value} target="_blank" rel="noopener">{key.toUpperCase()} ↗</a>)}</div>}
      </li>
    ))}
  </ol>
</Section>
<style>
  .pubs {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 18px;
    list-style: none;
    counter-reset: publication;
  }

  .pub {
    position: relative;
    grid-column: span 4;
    min-width: 0;
    padding: 22px;
    border: 1px solid var(--ink);
    background: var(--paper-card);
    counter-increment: publication;
  }

  .pub--featured {
    grid-column: span 6;
    min-height: 290px;
    padding: clamp(28px, 4vw, 44px);
    border: var(--stroke);
    background: var(--green-bright);
    box-shadow: var(--shadow-card);
  }

  .pub--archive::before {
    position: absolute;
    top: 20px;
    right: 20px;
    color: var(--outline);
    content: counter(publication, decimal-leading-zero);
    font: 500 10px/1 var(--font-note);
  }

  .pub-index {
    position: absolute;
    top: 22px;
    right: 22px;
    display: grid;
    width: 46px;
    height: 46px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    place-items: center;
    color: var(--ink);
    background: var(--orange);
    box-shadow: 2px 2px 0 var(--ink);
    font: 400 24px/1 var(--font-display);
    opacity: 1;
  }

  .pub-meta {
    display: flex;
    flex-wrap: wrap;
    width: fit-content;
    max-width: calc(100% - 58px);
    margin-bottom: 22px;
    border: 1px solid var(--ink);
    color: var(--muted);
    background: var(--paper);
    font: 500 10px/1.35 var(--font-note);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .pub-meta span {
    padding: 6px 8px;
  }

  .pub-meta span:first-child {
    color: var(--paper);
    background: var(--ink);
  }

  .pub-meta span + span {
    border-left: 1px solid var(--ink);
  }

  .pub h3 {
    position: relative;
    font-size: clamp(17px, 2vw, 23px);
    font-weight: 700;
    line-height: 1.25;
  }

  .pub--featured h3 {
    max-width: 660px;
    font-size: clamp(23px, 3.2vw, 38px);
    line-height: 1.12;
  }

  .star {
    margin-left: 8px;
    color: var(--ink);
    font-size: .65em;
    vertical-align: top;
  }

  .pub-authors {
    margin-top: 16px;
    color: var(--muted);
    font: 500 11px/1.55 var(--font-note);
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }

  .pub-links a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 7px 9px;
    border: 1px solid var(--ink);
    background: var(--orange);
    box-shadow: 2px 2px 0 var(--ink);
    font: 500 10px/1 var(--font-note);
    letter-spacing: .05em;
  }

  .pub-links a:hover {
    transform: translate(1px, 1px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  @media (max-width: 860px) {
    .pub,
    .pub--featured {
      grid-column: span 6;
    }
  }

  @media (max-width: 780px) {
    .pubs {
      display: block;
    }

    .pub {
      margin-bottom: 16px;
    }

    .pub--featured {
      min-height: 0;
      box-shadow: 4px 4px 0 var(--ink);
    }
  }
</style>
