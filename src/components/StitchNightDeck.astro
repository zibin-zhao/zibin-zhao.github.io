<script>
  type Fragment = {
    tx: number;
    ty: number;
    sx: number;
    sy: number;
    x: number;
    y: number;
    size: number;
    variant: number;
    rot: number;
    hue: number;
    tone: number;
    phase: number;
    delay: number;
  };

  const BIRD_HUES = [328, 342, 38, 52, 148, 168, 188, 204, 262, 282, 46];
  const BIRD_CELL = 18;
  const MORPH_MS = 1500;
  const CHIP_DUR = 1200;

  const section = document.getElementById('night-deck');
  const canvas = document.getElementById('deck-canvas') as HTMLCanvasElement | null;
  const frames = Array.from(document.querySelectorAll<HTMLElement>('.deck-frame'));
  const ticks = Array.from(document.querySelectorAll<HTMLButtonElement>('.deck-tick'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const state = {
    w: 0,
    h: 0,
    dpr: 1,
    frame: 0,
    fragments: [] as Fragment[],
    mode: 'morph' as 'morph' | 'fast' | 'static',
    modeSince: 0,
    lightX: 0,
    lightY: 0,
    lightTargetX: 0,
    lightTargetY: 0,
    lastPointerAt: 0,
    locked: false,
    lastStepAt: 0,
    timer: 0,
    inView: true,
    moon: { illum: 1, waxing: true } as Moon,
  };

  let bgLayer: HTMLCanvasElement | null = null;
  let shellLayer: HTMLCanvasElement | null = null;
  let mainCtx: CanvasRenderingContext2D | null = null;
  let birdAtlas: HTMLCanvasElement | null = null;

  const rand = (min: number, max: number) => min + Math.random() * (max - min);
  const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  function buildBirdAtlas(dpr: number): HTMLCanvasElement | null {
    const atlas = document.createElement('canvas');
    atlas.width = BIRD_CELL * BIRD_HUES.length * dpr;
    atlas.height = BIRD_CELL * dpr;
    const c = atlas.getContext('2d');
    if (!c) return null;
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    c.lineCap = 'round';
    c.lineJoin = 'round';
    BIRD_HUES.forEach((hue, i) => {
      const silver = i === BIRD_HUES.length - 1;
      c.strokeStyle = `hsla(${hue}, ${silver ? 16 : 72}%, 74%, 0.95)`;
      c.lineWidth = 1.7;
      const cx = i * BIRD_CELL + BIRD_CELL / 2;
      const cy = BIRD_CELL / 2 + 1.5;
      c.beginPath();
      c.moveTo(cx - 6.4, cy + 1.8);
      c.quadraticCurveTo(cx - 3, cy - 3.2, cx, cy);
      c.quadraticCurveTo(cx + 3, cy - 3.2, cx + 6.4, cy + 1.8);
      c.stroke();
      c.beginPath();
      c.moveTo(cx, cy + 0.6);
      c.lineTo(cx - 0.9, cy + 3.6);
      c.stroke();
    });
    return atlas;
  }

  function variantFor(hue: number): number {
    const h = ((hue % 360) + 360) % 360;
    let best = 0;
    let bestDist = 999;
    for (let i = 0; i < BIRD_HUES.length; i++) {
      const dist = Math.abs(BIRD_HUES[i] - h);
      if (dist < bestDist) {
        bestDist = dist;
        best = i;
      }
    }
    return best;
  }

  function makeNacre(): { hue: number } {
    if (Math.random() < 0.14) return { hue: rand(30, 60) };
    const hues = [328, 342, 38, 52, 148, 168, 188, 204, 262, 282];
    return { hue: hues[Math.floor(Math.random() * hues.length)] + rand(-8, 8) };
  }

  // 今夜真实月相: 以 2000-01-06 18:14 UTC 新月为历元
  type Moon = { illum: number; waxing: boolean };
  function moonPhase(now = new Date()): Moon {
    const synodic = 29.53058867;
    const epoch = Date.UTC(2000, 0, 6, 18, 14);
    let age = ((now.getTime() - epoch) / 86400000) % synodic;
    if (age < 0) age += synodic;
    const frac = age / synodic;
    return { illum: (1 - Math.cos(frac * Math.PI * 2)) / 2, waxing: frac < 0.5 };
  }

  // 月亮入漆: 亮面照常入样, 暗面刻回黑底, 新月只余一线轮
  function fillMoon(m: CanvasRenderingContext2D, cx: number, cy: number, r: number, moon: Moon): void {
    m.beginPath();
    m.arc(cx, cy, r, 0, Math.PI * 2);
    m.fill();
    if (moon.illum >= 0.985) return;
    m.fillStyle = 'rgb(0,0,0)';
    if (moon.illum <= 0.015) {
      m.beginPath();
      m.arc(cx, cy, r, 0, Math.PI * 2);
      m.arc(cx, cy, r * 0.86, 0, Math.PI * 2, true);
      m.fill('evenodd');
      return;
    }
    const t = Math.acos(Math.max(-1, Math.min(1, 1 - 2 * moon.illum)));
    const a = r * Math.cos(t);
    m.beginPath();
    if (moon.waxing) {
      // 亮面在右: 暗面 = 左半圆 + 晨昏线椭圆
      m.arc(cx, cy, r, -Math.PI / 2, Math.PI / 2, true);
      m.ellipse(cx, cy, Math.abs(a), r, 0, Math.PI / 2, -Math.PI / 2, a > 0);
    } else {
      // 亮面在左: 暗面 = 右半圆 + 晨昏线椭圆
      m.arc(cx, cy, r, -Math.PI / 2, Math.PI / 2, false);
      m.ellipse(cx, cy, Math.abs(a), r, 0, Math.PI / 2, -Math.PI / 2, a <= 0);
    }
    m.closePath();
    m.fill();
  }

  type MaskCtx = { m: CanvasRenderingContext2D; cv: HTMLCanvasElement; u: (f: number) => number; v: (f: number) => number; h: number; w: number };

  function maskBase(w: number, h: number): { canvas: HTMLCanvasElement; ctx: MaskCtx } | null {
    const cv = document.createElement('canvas');
    cv.width = w;
    cv.height = h;
    const m = cv.getContext('2d');
    if (!m) return null;
    m.fillStyle = '#000';
    m.fillRect(0, 0, w, h);
    m.lineCap = 'round';
    return { canvas: cv, ctx: { m, cv, u: (f) => f * w, v: (f) => f * h, h, w } };
  }

  function ripple(g: MaskCtx, x: number, y: number, len: number, color: string): void {
    const { m } = g;
    m.fillStyle = color;
    m.save();
    m.translate(x, y);
    m.rotate(rand(-0.03, 0.03));
    const r = Math.max(1, g.h * 0.0012);
    m.beginPath();
    m.roundRect(-len / 2, -r / 2, len, r, r);
    m.fill();
    m.restore();
  }

  function drawCalm(g: MaskCtx): void {
    const { m, u, v } = g;
    m.fillStyle = 'rgb(190,190,190)';
    for (let i = 0; i < 46; i++) {
      m.beginPath();
      m.arc(rand(u(0.05), u(0.95)), rand(v(0.06), v(0.9)), rand(0.7, 1.5), 0, Math.PI * 2);
      m.fill();
    }
    for (let i = 0; i < 5; i++) {
      ripple(g, rand(u(0.1), u(0.9)), rand(v(0.72), v(0.9)), rand(u(0.03), u(0.07)), 'rgb(150,150,150)');
    }
  }

  function drawGateScene(g: MaskCtx, moon: Moon): void {
    const { m, u, v, h } = g;
    const w = g.w;
    const minDim = Math.min(w, h);
    const waterline = v(0.615);
    const moonX = u(0.74);
    const moonY = v(0.24);
    const moonR = Math.min(74, Math.max(22, minDim * 0.07));
    m.fillStyle = 'rgb(200,200,200)';
    for (let i = 0; i < 30; i++) {
      const x = rand(u(0.03), u(0.97));
      const y = rand(v(0.05), v(0.48));
      if (Math.hypot(x - moonX, y - moonY) < moonR * 2) continue;
      m.beginPath();
      m.arc(x, y, rand(0.6, 1.3), 0, Math.PI * 2);
      m.fill();
    }
    m.fillStyle = 'rgb(255,255,255)';
    fillMoon(m, moonX, moonY, moonR, moon);
    const range = (points: Array<[number, number]>, color: string) => {
      m.fillStyle = color;
      m.beginPath();
      m.moveTo(u(points[0][0]), v(points[0][1]));
      for (const [fx, fy] of points) m.lineTo(u(fx), v(fy));
      m.lineTo(u(points[points.length - 1][0]), waterline + 4);
      m.lineTo(u(points[0][0]), waterline + 4);
      m.closePath();
      m.fill();
    };
    range([[0.0, 0.6], [0.1, 0.5], [0.2, 0.565], [0.3, 0.538], [0.4, 0.6], [0.47, 0.615]], 'rgb(110,110,110)');
    range([[0.03, 0.615], [0.13, 0.578], [0.23, 0.615]], 'rgb(150,150,150)');
    m.fillStyle = 'rgb(255,255,255)';
    m.beginPath();
    m.moveTo(u(0.3), v(0.603));
    m.quadraticCurveTo(u(0.37), v(0.648), u(0.445), v(0.651));
    m.quadraticCurveTo(u(0.52), v(0.647), u(0.552), v(0.606));
    m.quadraticCurveTo(u(0.43), v(0.622), u(0.3), v(0.603));
    m.closePath();
    m.fill();
    const fx = u(0.43);
    m.beginPath();
    m.moveTo(fx, v(0.532));
    m.lineTo(u(0.4), v(0.556));
    m.lineTo(u(0.46), v(0.556));
    m.closePath();
    m.fill();
    m.beginPath();
    m.ellipse(fx, v(0.556), u(0.035), Math.max(2, h * 0.007), 0, 0, Math.PI * 2);
    m.fill();
    m.beginPath();
    m.arc(fx, v(0.568), Math.max(4, h * 0.011), 0, Math.PI * 2);
    m.fill();
    m.beginPath();
    m.ellipse(u(0.427), v(0.6), u(0.026), h * 0.037, -0.12, 0, Math.PI * 2);
    m.fill();
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(2, h * 0.0032);
    m.beginPath();
    m.moveTo(u(0.447), v(0.585));
    m.lineTo(u(0.467), v(0.572));
    m.stroke();
    m.lineWidth = Math.max(1.4, h * 0.002);
    m.beginPath();
    m.moveTo(u(0.463), v(0.575));
    m.lineTo(u(0.545), v(0.532));
    m.stroke();
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(1.6, h * 0.0024);
    m.beginPath();
    m.moveTo(u(0.318), v(0.612));
    m.lineTo(u(0.305), v(0.545));
    m.stroke();
    m.fillStyle = 'rgb(255,255,255)';
    m.beginPath();
    m.arc(u(0.3035), v(0.537), Math.max(4.5, h * 0.012), 0, Math.PI * 2);
    m.fill();
    for (let i = 0; i < 6; i++) {
      const baseX = rand(u(0.02), u(0.12));
      const tipY = rand(v(0.42), v(0.58));
      const bend = rand(u(0.02), u(0.05));
      m.strokeStyle = 'rgb(200,200,200)';
      m.lineWidth = rand(2, 3.2);
      m.beginPath();
      m.moveTo(baseX, h + 8);
      m.quadraticCurveTo(baseX + bend * 0.4, v(0.76), baseX + bend, tipY);
      m.stroke();
    }
    // 水中倒影: 与本体留出一线江面, 纵向压缩, 随深度淡出
    const reflectH = waterline * 0.7;
    m.save();
    m.globalAlpha = 0.26;
    m.translate(0, (waterline + 10) * 2);
    m.scale(1, -0.72);
    m.drawImage(g.cv, 0, 0, w, waterline, 0, 0, w, waterline);
    m.restore();
    const fade = m.createLinearGradient(0, waterline, 0, waterline + reflectH);
    fade.addColorStop(0, 'rgba(0,0,0,0.25)');
    fade.addColorStop(1, 'rgba(0,0,0,0.95)');
    m.fillStyle = fade;
    m.fillRect(0, waterline, w, reflectH);
  }

  function drawHelix(g: MaskCtx): void {
    const { m, u, v, h } = g;
    const w = g.w;
    const portrait = h > w * 1.2;
    const cx = u(portrait ? 0.5 : 0.42);
    const topY = v(0.12);
    const bottomY = v(0.88);
    const amp = u(portrait ? 0.16 : 0.085);
    const steps = Math.round((bottomY - topY) / Math.max(3, h * 0.006));
    const ptsA: Array<[number, number]> = [];
    const ptsB: Array<[number, number]> = [];
    for (let i = 0; i <= steps; i++) {
      const y = topY + ((bottomY - topY) * i) / steps;
      const theta = (i / steps) * Math.PI * 4;
      ptsA.push([cx + Math.sin(theta) * amp, y]);
      ptsB.push([cx - Math.sin(theta) * amp, y]);
    }
    const strand = (pts: Array<[number, number]>) => {
      m.strokeStyle = 'rgb(200,200,200)';
      m.lineWidth = Math.max(2.2, h * 0.0038);
      m.beginPath();
      m.moveTo(pts[0][0], pts[0][1]);
      for (const [x, y] of pts) m.lineTo(x, y);
      m.stroke();
    };
    strand(ptsA);
    strand(ptsB);
    const rungH = Math.max(2, h * 0.0028);
    for (let i = 0; i <= steps; i += 3) {
      const y = topY + ((bottomY - topY) * i) / steps;
      const xA = ptsA[i][0];
      const xB = ptsB[i][0];
      m.fillStyle = i % 24 === 12 ? 'rgb(255,255,255)' : 'rgb(150,150,150)';
      m.beginPath();
      m.roundRect(Math.min(xA, xB), y - rungH / 2, Math.abs(xA - xB), rungH, rungH);
      m.fill();
    }
    m.fillStyle = 'rgb(255,255,255)';
    for (let i = 0; i <= steps; i += 4) {
      for (const pts of [ptsA, ptsB]) {
        m.beginPath();
        m.arc(pts[i][0], pts[i][1], rand(1.8, 3.2), 0, Math.PI * 2);
        m.fill();
      }
    }
  }

  function drawBoat(g: MaskCtx, moon: Moon): void {
    const { m, u, v, h } = g;
    const w = g.w;
    const waterline = v(0.615);
    const moonX = u(0.74);
    const moonY = v(0.22);
    const moonR = Math.min(66, Math.max(20, Math.min(w, h) * 0.06));
    m.fillStyle = 'rgb(200,200,200)';
    for (let i = 0; i < 22; i++) {
      const x = rand(u(0.05), u(0.95));
      const y = rand(v(0.05), v(0.45));
      if (Math.hypot(x - moonX, y - moonY) < moonR * 2) continue;
      m.beginPath();
      m.arc(x, y, rand(0.6, 1.3), 0, Math.PI * 2);
      m.fill();
    }
    m.fillStyle = 'rgb(255,255,255)';
    fillMoon(m, moonX, moonY, moonR, moon);
    const bx = 0.42;
    const s = 1.5;
    const hp = (dx: number, dy: number): [number, number] => [u(bx + dx * s), v(0.615 + dy * s)];
    m.beginPath();
    const st = hp(-0.125, 0);
    m.moveTo(st[0], st[1]);
    const segs: Array<[[number, number], [number, number]]> = [
      [hp(-0.06, 0.045), hp(0.015, 0.048)],
      [hp(0.075, 0.044), hp(0.107, 0)],
      [hp(-0.01, 0.018), hp(-0.125, 0)],
    ];
    for (const [control, end] of segs) m.quadraticCurveTo(control[0], control[1], end[0], end[1]);
    m.closePath();
    m.fill();
    const deck = v(0.583);
    m.fillStyle = 'rgb(200,200,200)';
    m.beginPath();
    m.roundRect(u(0.345), deck - h * 0.014, u(0.03), h * 0.014, h * 0.002);
    m.fill();
    m.beginPath();
    m.roundRect(u(0.348), deck - h * 0.027, u(0.025), h * 0.013, h * 0.002);
    m.fill();
    m.fillStyle = 'rgb(255,255,255)';
    m.beginPath();
    m.moveTo(u(0.396), deck);
    m.lineTo(u(0.378), deck);
    m.lineTo(u(0.388), deck - h * 0.033);
    m.lineTo(u(0.388), deck - h * 0.045);
    m.lineTo(u(0.393), deck - h * 0.045);
    m.lineTo(u(0.393), deck - h * 0.033);
    m.closePath();
    m.fill();
    m.fillStyle = 'rgb(200,200,200)';
    m.beginPath();
    m.arc(u(0.427), deck - h * 0.018, Math.max(5, h * 0.019), 0, Math.PI * 2);
    m.fill();
    m.beginPath();
    m.arc(u(0.458), deck - h * 0.015, Math.max(4, h * 0.016), 0, Math.PI * 2);
    m.fill();
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(1.6, h * 0.0024);
    m.beginPath();
    m.moveTo(u(bx - 0.107 * s), v(0.615 + 0.012 * s));
    m.lineTo(u(bx - 0.12 * s), v(0.615 - 0.055 * s));
    m.stroke();
    m.fillStyle = 'rgb(255,255,255)';
    m.beginPath();
    m.arc(u(bx - 0.1215 * s), v(0.615 - 0.063 * s), Math.max(4.5, h * 0.012), 0, Math.PI * 2);
    m.fill();
    m.save();
    m.globalAlpha = 0.3;
    m.translate(0, waterline * 2);
    m.scale(1, -1);
    m.drawImage(g.cv, 0, 0, w, waterline, 0, 0, w, waterline * 0.96);
    m.restore();
  }

  function drawLantern(g: MaskCtx): void {
    const { m, u, v, h } = g;
    const cx = u(0.5);
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(2, h * 0.003);
    m.beginPath();
    m.moveTo(cx, v(0.12));
    m.lineTo(cx, v(0.24));
    m.stroke();
    m.lineWidth = Math.max(2.4, h * 0.004);
    m.strokeStyle = 'rgb(255,255,255)';
    m.beginPath();
    m.roundRect(cx - u(0.075), v(0.24), u(0.15), v(0.34), u(0.055));
    m.stroke();
    m.strokeStyle = 'rgb(200,200,200)';
    m.lineWidth = Math.max(1.6, h * 0.0026);
    for (const off of [-0.038, 0.038]) {
      m.beginPath();
      m.moveTo(cx + off * 0.6, v(0.25));
      m.quadraticCurveTo(cx + off * 1.6, v(0.41), cx + off * 0.6, v(0.57));
      m.stroke();
    }
    m.fillStyle = 'rgb(230,201,138)';
    m.beginPath();
    m.arc(cx, v(0.41), Math.max(3, h * 0.008), 0, Math.PI * 2);
    m.fill();
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(1.6, h * 0.0024);
    m.beginPath();
    m.moveTo(cx, v(0.58));
    m.lineTo(cx, v(0.68));
    m.stroke();
    m.fillStyle = '#b5372c';
    m.beginPath();
    m.arc(cx, v(0.7), Math.max(3.4, h * 0.007), 0, Math.PI * 2);
    m.fill();
    m.fillStyle = 'rgb(200,200,200)';
    for (let i = 0; i < 26; i++) {
      m.beginPath();
      m.arc(rand(u(0.06), u(0.94)), rand(v(0.06), v(0.9)), rand(0.7, 1.4), 0, Math.PI * 2);
      m.fill();
    }
  }

  function drawGoose(g: MaskCtx): void {
    const { m, u, v, h } = g;
    m.strokeStyle = 'rgb(255,255,255)';
    m.lineWidth = Math.max(3, h * 0.006);
    m.lineCap = 'round';
    m.beginPath();
    m.moveTo(u(0.22), v(0.44));
    m.quadraticCurveTo(u(0.36), v(0.28), u(0.47), v(0.4));
    m.quadraticCurveTo(u(0.58), v(0.28), u(0.72), v(0.4));
    m.stroke();
    m.strokeStyle = 'rgb(200,200,200)';
    m.lineWidth = Math.max(2, h * 0.0036);
    m.beginPath();
    m.moveTo(u(0.32), v(0.56));
    m.quadraticCurveTo(u(0.4), v(0.48), u(0.47), v(0.54));
    m.stroke();
    m.fillStyle = '#b5372c';
    m.beginPath();
    m.arc(u(0.47), v(0.4), Math.max(3.4, h * 0.007), 0, Math.PI * 2);
    m.fill();
    m.fillStyle = 'rgb(200,200,200)';
    for (let i = 0; i < 24; i++) {
      m.beginPath();
      m.arc(rand(u(0.08), u(0.92)), rand(v(0.1), v(0.85)), rand(0.7, 1.4), 0, Math.PI * 2);
      m.fill();
    }
  }

  function frameMask(frame: number, w: number, h: number, moon: Moon): HTMLCanvasElement {
    const base = maskBase(w, h);
    if (!base) return document.createElement('canvas');
    const g = base.ctx;
    if (frame === 0) drawGateScene(g, moon);
    else if (frame === 1) drawHelix(g);
    else if (frame === 2) drawBoat(g, moon);
    else if (frame === 3) drawLantern(g);
    else if (frame === 4) drawGoose(g);
    else drawCalm(g);
    return base.canvas;
  }

  function sampleMask(mask: HTMLCanvasElement, w: number, h: number): Array<{ x: number; y: number; tone: number }> {
    const mctx = mask.getContext('2d');
    if (!mctx) return [];
    const image = mctx.getImageData(0, 0, w, h).data;
    let step = Math.max(3, Math.round(Math.min(w, h) / 195));
    let targets: Array<{ x: number; y: number; tone: number }> = [];
    for (let attempt = 0; attempt < 5; attempt++) {
      targets = [];
      for (let y = step / 2; y < h; y += step) {
        for (let x = step / 2; x < w; x += step) {
          const px = (Math.floor(y) * w + Math.floor(x)) * 4;
          const tone = image[px] / 255;
          if (tone <= 0.05 || Math.random() > tone * 0.95) continue;
          targets.push({ x: x + rand(-step * 0.5, step * 0.5), y: y + rand(-step * 0.5, step * 0.5), tone });
        }
      }
      if (targets.length <= 16000) break;
      step += 1;
    }
    return targets;
  }

  function makeFragment(x: number, y: number, step: number): Fragment {
    const nacre = makeNacre();
    return {
      tx: x,
      ty: y,
      sx: x,
      sy: y,
      x,
      y,
      size: step * rand(1.1, 1.7),
      variant: variantFor(nacre.hue),
      rot: rand(-0.35, 0.35),
      hue: nacre.hue,
      tone: 1,
      phase: rand(0, Math.PI * 2),
      delay: 0,
    };
  }

  function morphToFrame(frame: number, initial: boolean, now: number, instant = false): void {
    const { w, h } = state;
    const moon = moonPhase();
    const targets = sampleMask(frameMask(frame, w, h, moon), w, h);
    if (targets.length === 0) return;
    const step = Math.max(3, Math.round(Math.min(w, h) / 195));
    while (state.fragments.length < targets.length) {
      state.fragments.push(makeFragment(rand(-w * 0.1, w * 1.1), rand(-h * 0.1, h * 1.1), step));
    }
    const usage = new Map<number, number>();
    state.fragments.forEach((f, i) => {
      const ti = i % targets.length;
      const dup = usage.get(ti) ?? 0;
      usage.set(ti, dup + 1);
      const target = targets[ti];
      const spread = dup > 0 ? dup * step * 0.4 : 0;
      f.sx = initial ? rand(-w * 0.1, w * 1.1) : f.x;
      f.sy = initial ? rand(-h * 0.2, h * 1.2) : f.y;
      f.tx = target.x + rand(-spread, spread);
      f.ty = target.y + rand(-spread, spread);
      f.tone = target.tone;
      const nacre = makeNacre();
      f.hue = nacre.hue;
      f.variant = variantFor(nacre.hue);
      f.size = step * rand(1.1, 1.7);
      f.rot = rand(-0.35, 0.35);
      f.delay = rand(0, initial ? 600 : 450);
    });
    if (instant || reduceMotion.matches) {
      for (const f of state.fragments) {
        f.x = f.tx;
        f.y = f.ty;
      }
      state.mode = 'static';
      state.modeSince = now;
      shellLayer = bakeShell(state.fragments, w, h, state.dpr);
      render(now);
      state.locked = false;
      return;
    }
    state.mode = 'morph';
    state.modeSince = now;
    shellLayer = null;
  }

  function paintBase(w: number, h: number, dpr: number): HTMLCanvasElement | null {
    const layer = document.createElement('canvas');
    layer.width = Math.round(w * dpr);
    layer.height = Math.round(h * dpr);
    const c = layer.getContext('2d');
    if (!c) return null;
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    const gradient = c.createLinearGradient(0, 0, 0, h);
    gradient.addColorStop(0, '#0b0b10');
    gradient.addColorStop(0.55, '#08080b');
    gradient.addColorStop(1, '#050507');
    c.fillStyle = gradient;
    c.fillRect(0, 0, w, h);
    for (let i = 0; i < 14; i++) {
      const x = rand(0, w);
      const y = rand(0, h);
      const r = rand(Math.min(w, h) * 0.08, Math.min(w, h) * 0.4);
      const blotch = c.createRadialGradient(x, y, 0, x, y, r);
      blotch.addColorStop(0, Math.random() < 0.5 ? 'rgba(30, 25, 21, 0.3)' : 'rgba(13, 16, 22, 0.3)');
      blotch.addColorStop(1, 'rgba(0, 0, 0, 0)');
      c.fillStyle = blotch;
      c.fillRect(x - r, y - r, r * 2, r * 2);
    }
    return layer;
  }

  function bakeShell(fragments: Fragment[], w: number, h: number, dpr: number): HTMLCanvasElement | null {
    if (!birdAtlas) return null;
    const layer = document.createElement('canvas');
    layer.width = Math.round(w * dpr);
    layer.height = Math.round(h * dpr);
    const c = layer.getContext('2d');
    if (!c) return null;
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    for (const f of fragments) {
      const glint = f.tone > 0.85 && f.delay < 110 ? 0.14 : 0;
      c.globalAlpha = Math.min(1, 0.24 + 0.34 * f.tone + glint);
      const cos = Math.cos(f.rot);
      const sin = Math.sin(f.rot);
      c.setTransform(cos * dpr, sin * dpr, -sin * dpr, cos * dpr, f.tx * dpr, f.ty * dpr);
      c.drawImage(birdAtlas, f.variant * BIRD_CELL * dpr, 0, BIRD_CELL * dpr, BIRD_CELL * dpr, -f.size / 2, -f.size / 2, f.size, f.size);
    }
    c.globalAlpha = 1;
    c.setTransform(dpr, 0, 0, dpr, 0, 0);
    return layer;
  }

  function drawBird(c: CanvasRenderingContext2D, scale: number, f: Fragment, variant: number, alpha: number, sizeMul: number): void {
    if (!birdAtlas) return;
    c.globalAlpha = Math.max(0, Math.min(1, alpha));
    const size = f.size * sizeMul;
    const cos = Math.cos(f.rot);
    const sin = Math.sin(f.rot);
    c.setTransform(cos * scale, sin * scale, -sin * scale, cos * scale, f.x * scale, f.y * scale);
    c.drawImage(birdAtlas, variant * BIRD_CELL * scale, 0, BIRD_CELL * scale, BIRD_CELL * scale, -size / 2, -size / 2, size, size);
    c.globalAlpha = 1;
  }

  let glowBuckets: number[][] = [];
  function rebuildBuckets(): void {
    const count = Math.ceil(state.w / 72) + 1;
    glowBuckets = new Array(count);
    for (let i = 0; i < count; i++) glowBuckets[i] = [];
    state.fragments.forEach((f, i) => {
      const b = Math.min(count - 1, Math.max(0, Math.floor(f.tx / 72)));
      glowBuckets[b].push(i);
    });
  }

  function render(now: number): void {
    if (!mainCtx || !bgLayer) return;
    const ctx = mainCtx;
    const { w, h, dpr, fragments } = state;
    const elapsed = now - state.modeSince;

    if (!reduceMotion.matches) {
      const idle = now - state.lastPointerAt > 3500;
      if (idle) {
        // 无人操作时, 光圈沿缓慢的利萨如轨迹巡游
        state.lightTargetX = w * (0.5 + 0.3 * Math.sin(now * 0.00013));
        state.lightTargetY = h * (0.44 + 0.18 * Math.sin(now * 0.00009 + 1.7));
      }
      state.lightX += (state.lightTargetX - state.lightX) * 0.3;
      state.lightY += (state.lightTargetY - state.lightY) * 0.3;
    }

    // 密度编排: 文字越密的帧, 粒子退得越远, 把视线让给内容
    const FRAME_DIM = [1, 0.32, 0.42, 0.42, 0.28];
    // 新月之夜: 整幅漆面沉半档, 那几晚真的是暗夜
    const moonDim = state.moon.illum < 0.1 ? 0.72 : 1;
    const dim = FRAME_DIM[state.frame] * moonDim;
    const settled = state.mode === 'fast' || state.mode === 'static';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.globalCompositeOperation = 'source-over';
    ctx.globalAlpha = 1;
    ctx.drawImage(bgLayer, 0, 0, w, h);

    // 圆形光圈: 强度按到光心的二维距离衰减; 文字密集帧光圈收小
    const R = Math.min(w, h) * (state.frame === 1 || state.frame === 4 ? 0.11 : 0.15);
    const sigma2 = 2 * (R * 0.55) * (R * 0.55);
    if (settled) {
      if (shellLayer) {
        ctx.globalAlpha = dim;
        ctx.drawImage(shellLayer, 0, 0, w, h);
        ctx.globalAlpha = 1;
      }
      ctx.globalCompositeOperation = 'lighter';
      const xMin = state.lightX - R * 1.4;
      const xMax = state.lightX + R * 1.4;
      const first = Math.max(0, Math.floor(xMin / 72));
      const last = Math.min(glowBuckets.length - 1, Math.ceil(xMax / 72));
      for (let b = first; b <= last; b++) {
        for (const bi of glowBuckets[b]) {
          const f = fragments[bi];
          const dx = f.tx - state.lightX;
          const dy = f.ty - state.lightY;
          const intensity = Math.exp(-(dx * dx + dy * dy) / sigma2);
          if (intensity < 0.02) continue;
          // 灯下看漆: 干涉色随灯与贝片的方位角流转, 每片相位不同, 虹彩才错落
          const lampAngle = Math.atan2(dy, dx);
          const irid = Math.cos(lampAngle * 2 + f.phase);
          const hue = f.hue + intensity * (16 + irid * 30) + Math.sin(now * 0.00035 + f.phase) * 8;
          drawBird(ctx, dpr, f, variantFor(hue), (0.18 + 0.8 * intensity) * f.tone * dim, 1 + intensity * 0.45);
        }
      }
    } else {
      for (const f of fragments) {
        const k = easeInOut(Math.min(1, Math.max(0, (elapsed - f.delay) / CHIP_DUR)));
        f.x = f.sx + (f.tx - f.sx) * k;
        f.y = f.sy + (f.ty - f.sy) * k;
        const dx = f.x - state.lightX;
        const dy = f.y - state.lightY;
        const intensity = Math.exp(-(dx * dx + dy * dy) / sigma2);
        const alpha = (0.1 + 0.18 * f.tone) * (0.35 + 0.65 * k) + intensity * 0.55 * f.tone;
        drawBird(ctx, dpr, f, f.variant, Math.min(1, alpha), 1);
      }
    }

    // 掌灯人的那一盏: 暖光, 而不是冷月光
    const glow = ctx.createRadialGradient(state.lightX, state.lightY, 0, state.lightX, state.lightY, R * 1.3);
    glow.addColorStop(0, `rgba(255, 216, 170, ${0.11 * dim})`);
    glow.addColorStop(0.45, `rgba(255, 216, 170, ${0.045 * dim})`);
    glow.addColorStop(1, 'rgba(255, 216, 170, 0)');
    ctx.fillStyle = glow;
    ctx.fillRect(state.lightX - R * 1.4, state.lightY - R * 1.4, R * 2.8, R * 2.8);
    ctx.globalCompositeOperation = 'source-over';

    if (state.mode === 'morph' && elapsed > MORPH_MS + 200) {
      state.mode = 'fast';
      state.modeSince = now;
      shellLayer = bakeShell(fragments, w, h, dpr);
      rebuildBuckets();
      state.locked = false;
    }
  }

  function gust(x: number, y: number, now: number): void {
    if (reduceMotion.matches || state.mode !== 'fast' || state.frame !== 0) return;
    state.mode = 'morph';
    state.modeSince = now;
    shellLayer = null;
    for (const f of state.fragments) {
      const dx = f.tx - x;
      const dy = f.ty - y;
      const dist = Math.hypot(dx, dy) || 1;
      if (dist > 260) continue;
      const force = Math.pow(1 - dist / 260, 2) * 50;
      f.sx = f.tx - (dx / dist) * force * 1.6;
      f.sy = f.ty - (dy / dist) * force * 1.1;
      f.delay = rand(0, 260);
    }
    void now;
  }

  function showFrame(index: number): void {
    frames.forEach((el, i) => el.classList.toggle('is-active', i === index));
    ticks.forEach((tick, i) => {
      tick.classList.toggle('is-here', i === index);
      if (i === index) tick.setAttribute('aria-current', 'true');
      else tick.removeAttribute('aria-current');
    });
    if (index > 0) {
      const progress = index / (frames.length - 1);
      window.dispatchEvent(new CustomEvent('nightdeck:frame', { detail: { progress } }));
    }
  }

  function goTo(index: number, now: number): void {
    const target = Math.min(frames.length - 1, Math.max(0, index));
    if (target === state.frame) return;
    state.locked = true;
    state.frame = target;
    showFrame(target);
    morphToFrame(target, false, now, reduceMotion.matches);
  }

  function step(dir: number, now?: number): void {
    if (state.locked) return;
    goTo(state.frame + dir, now ?? performance.now());
  }

  // 一次手势 = 一帧: 首个事件立即步进, morph 期间的后续事件全部丢弃
  let lastWheelAt = 0;
  window.addEventListener(
    'wheel',
    (event) => {
      event.preventDefault();
      const now = performance.now();
      if (state.locked || now - lastWheelAt < 300) return;
      lastWheelAt = now;
      const dir = (event.deltaY || event.deltaX) > 0 ? 1 : -1;
      step(dir, now);
    },
    { passive: false },
  );

  window.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement | null;
    const holder = target?.closest('a, input, textarea, button');
    // 章回刻度聚焦时保留方向键翻页, 空格与回车仍归按钮自身
    const onTick = holder instanceof HTMLElement && holder.classList.contains('deck-tick');
    if (holder && !onTick) return;
    const next = ['ArrowDown', 'ArrowRight', 'PageDown', ' ', 'Spacebar'];
    const prev = ['ArrowUp', 'ArrowLeft', 'PageUp'];
    const stepKey = next.includes(event.key) && !(onTick && (event.key === ' ' || event.key === 'Spacebar'));
    if (stepKey) {
      event.preventDefault();
      step(1);
    } else if (prev.includes(event.key)) {
      event.preventDefault();
      step(-1);
    } else if (event.key === 'Home') {
      event.preventDefault();
      goTo(0, performance.now());
    } else if (event.key === 'End') {
      event.preventDefault();
      goTo(frames.length - 1, performance.now());
    }
  });

  // 章回刻度: 一击即达
  for (const tick of ticks) {
    tick.addEventListener('click', () => {
      const index = Number(tick.dataset.tick);
      if (Number.isNaN(index) || state.locked) return;
      goTo(index, performance.now());
    });
  }

  const swipe = { x: 0, y: 0, moved: false, active: false };
  window.addEventListener('pointermove', (event) => {
    if (reduceMotion.matches) return;
    state.lightTargetX = event.clientX;
    state.lightTargetY = event.clientY;
    state.lightX = event.clientX;
    state.lightY = event.clientY;
    state.lastPointerAt = performance.now();
    if (swipe.active) {
      if (Math.abs(event.clientY - swipe.y) > 10 || Math.abs(event.clientX - swipe.x) > 10) swipe.moved = true;
    }
  });
  window.addEventListener('pointerdown', (event) => {
    if (reduceMotion.matches) return;
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('a, button')) return;
    swipe.x = event.clientX;
    swipe.y = event.clientY;
    swipe.moved = false;
    swipe.active = true;
    state.lastPointerAt = performance.now();
  });
  window.addEventListener('pointerup', (event) => {
    if (!swipe.active) return;
    swipe.active = false;
    const target = event.target instanceof Element ? event.target : null;
    if (target?.closest('a, button')) return;
    const dy = event.clientY - swipe.y;
    const dx = event.clientX - swipe.x;
    if (Math.abs(dy) > 48) step(dy < 0 ? 1 : -1);
    else if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
    else if (!swipe.moved && state.frame === 0) gust(event.clientX, event.clientY, performance.now());
  });

  // ---------- 离岸留灯 ----------

  const lampBtn = document.getElementById('deck-lamp');
  const lampNote = document.getElementById('deck-lamp-note');
  const LAMP_KEY = 'night-lamp';

  function applyLamp(stamp: string): void {
    if (!lampBtn) return;
    lampBtn.classList.add('is-lit');
    lampBtn.setAttribute('aria-pressed', 'true');
    const label = lampBtn.querySelector('.lamp-text');
    if (label) label.textContent = '灯已留';
    if (lampNote) {
      lampNote.textContent = `${stamp.split('-').join('.')} 夜 · 曾于此泊航`;
      lampNote.hidden = false;
    }
  }

  if (lampBtn) {
    try {
      const stored = localStorage.getItem(LAMP_KEY);
      if (stored) applyLamp(stored);
    } catch {
      /* Local storage may be unavailable. */
    }
    lampBtn.addEventListener('click', () => {
      const stamp = new Date().toISOString().slice(0, 10);
      try {
        localStorage.setItem(LAMP_KEY, stamp);
      } catch {
        /* Local storage may be unavailable. */
      }
      applyLamp(stamp);
    });
  }

  // ---------- 启动 ----------

  function setup(): void {
    if (!canvas || !section) return;
    stopLoop();
    const w = window.innerWidth;
    const h = window.innerHeight;
    if (w < 10 || h < 10) return;
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    state.w = w;
    state.h = h;
    state.dpr = dpr;
    state.moon = moonPhase();
    canvas.width = Math.round(w * dpr);
    canvas.height = Math.round(h * dpr);
    mainCtx = canvas.getContext('2d', { alpha: false });
    birdAtlas = buildBirdAtlas(dpr);
    bgLayer = paintBase(w, h, dpr);
    state.lightX = w * 0.3;
    state.lightY = h * 0.42;
    state.lightTargetX = state.lightX;
    state.lightTargetY = state.lightY;
    const hash = window.location.hash.replace('#', '');
    const hashFrame = { research: 1, 'research-projects': 2, vibe: 3, contact: 4 }[hash] ?? 0;
    state.frame = hashFrame;
    state.locked = false;
    showFrame(state.frame);
    morphToFrame(state.frame, true, performance.now());
    rebuildBuckets();
    startLoop();
  }

  function startLoop(): void {
    if (state.timer !== 0 || !state.inView) return;
    if (reduceMotion.matches) {
      render(performance.now());
      return;
    }
    if (state.timer !== 0) return;
    state.timer = window.setInterval(() => {
      if (document.hidden) return;
      render(performance.now());
    }, 33);
  }
  function stopLoop(): void {
    window.clearInterval(state.timer);
    state.timer = 0;
  }

  if (canvas && section) {
    setup();
    new ResizeObserver(() => {
      window.clearTimeout((window as unknown as { __deckResize?: number }).__deckResize);
      (window as unknown as { __deckResize?: number }).__deckResize = window.setTimeout(() => setup(), 250);
    }).observe(section);
    new IntersectionObserver(
      (entries) => {
        state.inView = (entries[0]?.intersectionRatio ?? 0) > 0.1;
        if (state.inView) startLoop();
        else stopLoop();
      },
      { threshold: [0, 0.12] },
    ).observe(section);
  }
</script>
