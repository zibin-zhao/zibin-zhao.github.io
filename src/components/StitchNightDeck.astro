---
import { getCollection } from 'astro:content';
import { HOME_RESEARCH_TITLES, HOME_VIBE_TITLES, selectByTitles } from '../data/home';
import { getGithubProjects, partitionGithubProjects } from '../data/github-projects';
import { profile } from '../data/profile';
import T from './T.astro';

const publications = selectByTitles(
  (await getCollection('publications')).map((entry) => entry.data),
  HOME_RESEARCH_TITLES,
);
const githubProjects = await getGithubProjects();
const { research } = partitionGithubProjects(githubProjects);
const vibes = selectByTitles(
  (await getCollection('vibe')).map((entry) => entry.data),
  HOME_VIBE_TITLES,
);

const VIBE_ART: Record<string, string> = {
  singularity: [
    '<circle cx="160" cy="70" r="4" fill="#e6c98a"/>',
    '<ellipse cx="160" cy="70" rx="24" ry="9" fill="none" stroke="rgba(236,231,216,0.8)" stroke-width="1.4" stroke-dasharray="1 7" stroke-linecap="round" transform="rotate(-24 160 70)"/>',
    '<ellipse cx="160" cy="70" rx="44" ry="17" fill="none" stroke="rgba(236,231,216,0.55)" stroke-width="1.4" stroke-dasharray="1 8" stroke-linecap="round" transform="rotate(18 160 70)"/>',
    '<ellipse cx="160" cy="70" rx="66" ry="26" fill="none" stroke="rgba(236,231,216,0.3)" stroke-width="1.4" stroke-dasharray="1 9" stroke-linecap="round" transform="rotate(-8 160 70)"/>',
  ].join(''),
  medit: [
    '<circle cx="232" cy="40" r="17" fill="none" stroke="rgba(236,231,216,0.85)" stroke-width="1.6"/>',
    '<path d="M40 96 H 210" stroke="rgba(236,231,216,0.6)" stroke-width="1.6" stroke-linecap="round"/>',
    '<path d="M64 110 H 250" stroke="rgba(236,231,216,0.4)" stroke-width="1.6" stroke-linecap="round"/>',
    '<path d="M96 124 H 210" stroke="rgba(236,231,216,0.25)" stroke-width="1.6" stroke-linecap="round"/>',
  ].join(''),
  yaos: [
    '<circle cx="160" cy="62" r="34" fill="none" stroke="rgba(230,201,138,0.18)" stroke-width="10"/>',
    '<path d="M160 12 V 30" stroke="rgba(236,231,216,0.8)" stroke-width="1.6"/>',
    '<rect x="148" y="30" width="24" height="6" rx="2" fill="none" stroke="rgba(236,231,216,0.8)" stroke-width="1.4"/>',
    '<rect x="140" y="36" width="40" height="50" rx="13" fill="none" stroke="rgba(230,201,138,0.9)" stroke-width="1.8"/>',
    '<rect x="151" y="86" width="18" height="5" rx="2" fill="none" stroke="rgba(236,231,216,0.8)" stroke-width="1.4"/>',
    '<path d="M160 91 V 106" stroke="rgba(236,231,216,0.7)" stroke-width="1.4"/>',
    '<circle cx="160" cy="110" r="2.6" fill="#b5372c"/>',
  ].join(''),
  zen: [
    '<circle cx="152" cy="70" r="36" fill="none" stroke="rgba(236,231,216,0.9)" stroke-width="5" stroke-linecap="round" stroke-dasharray="196 34" transform="rotate(-78 152 70)"/>',
    '<circle cx="206" cy="98" r="4" fill="#b5372c"/>',
  ].join(''),
  moon: ['<circle cx="160" cy="70" r="22" fill="none" stroke="rgba(236,231,216,0.8)" stroke-width="1.6"/>'].join(''),
};

const ACT_GLYPH: Record<string, string> = {
  xue: [
    '<path d="M20 6 C 32 12, 32 18, 20 24 C 8 30, 8 36, 20 42" fill="none" stroke="rgba(236,231,216,0.85)" stroke-width="1.6" stroke-linecap="round"/>',
    '<path d="M28 6 C 16 12, 16 18, 28 24 C 40 30, 40 36, 28 42" fill="none" stroke="rgba(236,231,216,0.85)" stroke-width="1.6" stroke-linecap="round"/>',
    '<path d="M17 12 H 31 M17 24 H 31 M17 36 H 31" stroke="rgba(230,201,138,0.8)" stroke-width="1.2"/>',
  ].join(''),
  qi: [
    '<path d="M8 30 Q 24 40, 40 30 L 36 38 Q 24 44, 12 38 Z" fill="none" stroke="rgba(236,231,216,0.85)" stroke-width="1.6" stroke-linejoin="round"/>',
    '<circle cx="18" cy="24" r="3.2" fill="none" stroke="rgba(230,201,138,0.9)" stroke-width="1.4"/>',
    '<rect x="26" y="20" width="7" height="8" rx="1.5" fill="none" stroke="rgba(236,231,216,0.8)" stroke-width="1.4"/>',
    '<path d="M38 22 l 4 -3" stroke="rgba(236,231,216,0.7)" stroke-width="1.4" stroke-linecap="round"/>',
  ].join(''),
  xian: [
    '<path d="M24 8 V 16" stroke="rgba(236,231,216,0.8)" stroke-width="1.4"/>',
    '<rect x="15" y="16" width="18" height="22" rx="8" fill="none" stroke="rgba(230,201,138,0.9)" stroke-width="1.6"/>',
    '<path d="M24 38 V 44 M21 46 H 27" stroke="rgba(236,231,216,0.8)" stroke-width="1.4" stroke-linecap="round"/>',
  ].join(''),
  xin: [
    '<path d="M10 30 Q 19 20, 26 28 Q 33 20, 40 26" fill="none" stroke="rgba(236,231,216,0.85)" stroke-width="1.8" stroke-linecap="round"/>',
    '<path d="M20 36 Q 27 30, 33 35" fill="none" stroke="rgba(236,231,216,0.5)" stroke-width="1.4" stroke-linecap="round"/>',
    '<circle cx="40" cy="24" r="1.6" fill="#b5372c"/>',
  ].join(''),
};

const pubRows = publications.map((paper) => {
  const links = Object.entries(paper.links ?? {}).filter(([, href]) => Boolean(href)) as [string, string][];
  const primaryHref = links[0]?.[1];
  const primaryLabel = primaryHref?.includes('doi.org')
    ? 'DOI ↗'
    : primaryHref?.includes('github.com')
      ? 'CODE ↗'
      : primaryHref?.includes('arxiv.org')
        ? 'arXiv ↗'
        : 'READ ↗';
  return { paper, primaryHref, primaryLabel };
});

const DECK_CHAPTERS = ['门厅', '研究', '造物', '生活', '联络'];
---

<section class="night-deck" id="night-deck" aria-label="螺钿夜航 — Zibin Zhao 的主页">
  <h1 class="sr-only">Zibin Zhao — 生物工程 × 人工智能 · 香港科技大学</h1>
  <canvas id="deck-canvas" aria-hidden="true"></canvas>
  <div class="deck-vignette" aria-hidden="true"></div>

  <noscript>
    <div class="deck-noscript">
      <p>螺钿夜航 —— Zibin Zhao · 生物工程 × 人工智能</p>
      <ul>
        <li><a href="/research/">研究</a></li>
        <li><a href="/projects/">造物</a></li>
        <li><a href="/contact/">联络</a></li>
        <li><a href="/night/">夜航</a></li>
      </ul>
    </div>
  </noscript>

  <!-- 帧一 · 门厅 -->
  <section class="deck-frame is-active" data-frame="0" aria-label="门厅">
    <p class="deck-hint" aria-hidden="true">滚动起航</p>
  </section>

  <!-- 帧 二 · 学 -->
  <section class="deck-frame" data-frame="1" aria-label="学 · 研究">
    <header class="act-head">
      <svg class="act-glyph" viewBox="0 0 48 48" aria-hidden="true" set:html={ACT_GLYPH.xue} />
      <h2 class="act-title" id="act-research-title"><T en="Research" zh="研究" /></h2>
      <i class="act-rule" aria-hidden="true"></i>
    </header>
    <p class="f-sub"><T en="Zibin Zhao · HKUST · Bioengineering × AI" zh="Zibin Zhao · 香港科大 · 生物工程 × 人工智能" /></p>
    <div class="pub-rows">
      {pubRows.map(({ paper, primaryHref, primaryLabel }) => (
        primaryHref ? (
          <a class="pub-row" href={primaryHref} target="_blank" rel="noopener noreferrer">
            <span class="pub-year">{paper.year}</span>
            <span class="pub-main">
              <span class="pub-title">{paper.title}</span>
              <span class="pub-meta">
                {paper.venue}
                {paper.firstAuthor && <b class="pub-first">第一作者</b>}
              </span>
            </span>
            <span class="pub-go">{primaryLabel}</span>
          </a>
        ) : (
          <div class="pub-row">
            <span class="pub-year">{paper.year}</span>
            <span class="pub-main">
              <span class="pub-title">{paper.title}</span>
              <span class="pub-meta">{paper.venue}</span>
            </span>
          </div>
        )
      ))}
    </div>
    <a class="act-more" href="/research/"><T en="Six more · Index ↗" zh="余六篇 · 目录 ↗" /></a>
  </section>

  <!-- 帧 三 · 器 -->
  <section class="deck-frame" data-frame="2" aria-label="器 · 造物">
    <header class="act-head">
      <svg class="act-glyph" viewBox="0 0 48 48" aria-hidden="true" set:html={ACT_GLYPH.qi} />
      <h2 class="act-title" id="act-projects-title"><T en="Made Things" zh="造物" /></h2>
      <i class="act-rule" aria-hidden="true"></i>
    </header>
    <div class="make-grid">
      {research.map((project) => (
        <a
          class="make-card"
          data-project={project.name}
          href={project.githubUrl || project.demoUrl || '#'}
          target={project.githubUrl || project.demoUrl ? '_blank' : undefined}
          rel="noopener"
        >
          <span class="make-name">{project.name}</span>
          <span class="make-desc">{project.descriptionZh || project.description}</span>
        </a>
      ))}
    </div>
    <a class="act-more" href="/projects/"><T en="All projects ↗" zh="项目页 ↗" /></a>
  </section>

  <!-- 帧 四 · 闲 -->
  <section class="deck-frame" data-frame="3" aria-label="闲 · 生活">
    <header class="act-head">
      <svg class="act-glyph" viewBox="0 0 48 48" aria-hidden="true" set:html={ACT_GLYPH.xian} />
      <h2 class="act-title" id="act-vibe-title"><T en="After Hours" zh="生活" /></h2>
      <i class="act-rule" aria-hidden="true"></i>
    </header>
    <div class="vibe-grid">
      {vibes.map((item) => {
        const href = item.href || item.githubUrl;
        const key = item.title.toLowerCase();
        const external = href?.startsWith('https://');
        const inner = (
          <>
            <svg class="vibe-art" viewBox="0 0 320 140" data-vibe-art={key} aria-hidden="true" set:html={VIBE_ART[key] ?? VIBE_ART.moon} />
            <span class="vibe-line">
              <span class="vibe-name">{item.title}</span>
              {item.comingSoon && <span class="vibe-soon">即将</span>}
            </span>
          </>
        );
        return href ? (
          <a class="vibe-card" data-vibe-art-card={key} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
            {inner}
          </a>
        ) : (
          <div class="vibe-card" data-vibe-art-card={key}>
            {inner}
          </div>
        );
      })}
    </div>
  </section>

  <!-- 帧 五 · 信 -->
  <section class="deck-frame" data-frame="4" aria-label="信 · 联络">
    <header class="act-head">
      <svg class="act-glyph" viewBox="0 0 48 48" aria-hidden="true" set:html={ACT_GLYPH.xin} />
      <h2 class="act-title" id="act-contact-title"><T en="Contact" zh="联络" /></h2>
      <i class="act-rule" aria-hidden="true"></i>
    </header>
    <a class="deck-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
    <div class="deck-socials">
      {profile.socials.map((social) => (
        <a href={social.href} target="_blank" rel="noopener">{social.label}</a>
      ))}
    </div>
    <div class="deck-links">
      <a href="/contact/"><T en="Contact ↗" zh="联络页 ↗" /></a>
      <a href="/night/"><T en="Full voyage ↗" zh="完整夜航 ↗" /></a>
    </div>
    <div class="deck-lamp-wrap">
      <button class="deck-lamp" id="deck-lamp" type="button" aria-pressed="false">
        <svg class="lamp-glyph" viewBox="0 0 24 24" aria-hidden="true">
          <path class="lamp-stroke" d="M12 2.5v2.4" />
          <path class="lamp-body" d="M8.2 10.2a3.8 3.8 0 0 1 7.6 0c0 2.4-1.3 3.4-1.3 5.3H9.5c0-1.9-1.3-2.9-1.3-5.3z" />
          <path class="lamp-stroke" d="M9.8 18.6h4.4" />
          <path class="lamp-stroke" d="M10.7 21h2.6" />
        </svg>
        <span class="lamp-text">留一盏灯</span>
      </button>
      <p class="deck-lamp-note" id="deck-lamp-note" hidden></p>
    </div>
  </section>

  <nav class="deck-progress" aria-label="夜航章节">
    {DECK_CHAPTERS.map((name, index) => (
      <button
        class="deck-tick"
        type="button"
        data-tick={index}
        aria-label={`第${index + 1}章 · ${name}`}
        aria-current={index === 0 ? 'true' : undefined}
      >
        <i class="tick-line" aria-hidden="true"></i>
        <span class="tick-num" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
      </button>
    ))}
  </nav>
</section>

<style>
  .night-deck {
    position: relative;
    /* 主页页脚坞隐藏, 不再为它保留 190px —— 那是移动端内容被裁掉的根源 */
    height: calc(100vh - 96px);
    height: calc(100dvh - 96px);
    overflow: hidden;
    background: #060608;
    color: #ece7d8;
  }
  @media (max-width: 700px) {
    .night-deck {
      height: calc(100vh - 76px);
      height: calc(100dvh - 76px);
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
  #deck-canvas {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: block;
  }
  .deck-vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 90% at 50% 42%, transparent 55%, rgba(2, 2, 4, 0.55) 100%);
  }
  .deck-noscript {
    position: relative;
    z-index: 3;
    padding: 24px;
    text-align: center;
  }
  .deck-noscript ul {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 18px;
    padding: 0;
  }
  .deck-noscript a {
    color: #ece7d8;
  }
  .deck-frame {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 20px clamp(20px, 5vw, 64px) 64px;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1000ms ease;
  }
  .deck-frame.is-active {
    display: flex;
    opacity: 1;
  }
  .deck-frame a,
  .deck-frame button {
    pointer-events: auto;
  }
  .act-head {
    display: flex;
    align-items: center;
    gap: 16px;
    align-self: stretch;
    margin: 0 0 18px;
  }
  .act-glyph {
    width: 42px;
    height: 42px;
    flex: none;
  }
  .act-title {
    margin: 0;
    font-family: 'Songti SC', 'STSong', 'Noto Serif CJK SC', serif;
    font-size: clamp(1.3rem, 2.6vw, 1.7rem);
    font-weight: 700;
    letter-spacing: 0.4em;
    color: #ece7d8;
  }
  .act-rule {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, #d886a8, #e6c98a, #9fd8b0, #8fd3f0, transparent);
    opacity: 0.75;
  }
  .f-sub {
    align-self: flex-start;
    margin: -8px 0 14px;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: rgba(236, 231, 216, 0.6);
  }
  .act-more {
    align-self: flex-end;
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: rgba(236, 231, 216, 0.6);
    text-decoration: none;
    border-bottom: 1px solid rgba(236, 231, 216, 0.35);
    padding-bottom: 2px;
    transition: color 240ms ease, border-color 240ms ease;
  }
  .act-more:hover,
  .act-more:focus-visible {
    color: #ece7d8;
    border-color: #ece7d8;
  }
  .act-more:focus-visible {
    outline: 1px solid rgba(236, 231, 216, 0.6);
    outline-offset: 4px;
  }
  .pub-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: min(760px, 100%);
  }
  .pub-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 16px;
    background: rgba(15, 15, 21, 0.72);
    border: 1px solid rgba(236, 231, 216, 0.22);
    color: #e6e2d4;
    text-decoration: none;
    text-align: left;
    transition: border-color 240ms ease, background 240ms ease;
  }
  a.pub-row:hover,
  a.pub-row:focus-visible {
    border-color: rgba(236, 231, 216, 0.6);
    background: rgba(20, 20, 26, 0.85);
  }
  .pub-row:focus-visible {
    outline: 1px solid rgba(236, 231, 216, 0.6);
    outline-offset: 3px;
  }
  .pub-year {
    flex: none;
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: rgba(236, 231, 216, 0.55);
  }
  .pub-main {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .pub-title {
    font-size: 0.92rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
  }
  .pub-meta {
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgba(236, 231, 216, 0.5);
  }
  .pub-first {
    font-weight: 400;
    color: #d8696a;
    margin-left: 0.6em;
  }
  .pub-go {
    flex: none;
    margin-left: auto;
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: rgba(236, 231, 216, 0.55);
  }
  .make-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: min(860px, 100%);
  }
  .make-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    background: rgba(15, 15, 21, 0.72);
    border: 1px solid rgba(236, 231, 216, 0.22);
    color: #e6e2d4;
    text-decoration: none;
    text-align: left;
    transition: border-color 240ms ease, background 240ms ease;
  }
  .make-card:hover,
  .make-card:focus-visible {
    border-color: rgba(236, 231, 216, 0.6);
    background: rgba(20, 20, 26, 0.85);
  }
  .make-card:focus-visible {
    outline: 1px solid rgba(236, 231, 216, 0.6);
    outline-offset: 3px;
  }
  .make-name {
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: #ece7d8;
  }
  .make-desc {
    font-size: 0.78rem;
    line-height: 1.6;
    letter-spacing: 0.04em;
    color: rgba(236, 231, 216, 0.55);
  }
  .vibe-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: min(720px, 100%);
  }
  .vibe-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    background: rgba(15, 15, 21, 0.72);
    border: 1px solid rgba(236, 231, 216, 0.22);
    color: #e6e2d4;
    text-decoration: none;
    transition: border-color 240ms ease, background 240ms ease;
  }
  a.vibe-card:hover,
  a.vibe-card:focus-visible {
    border-color: rgba(236, 231, 216, 0.6);
    background: rgba(20, 20, 26, 0.85);
  }
  .vibe-card:focus-visible {
    outline: 1px solid rgba(236, 231, 216, 0.6);
    outline-offset: 3px;
  }
  .vibe-art {
    width: 100%;
    height: auto;
    margin-bottom: 2px;
  }
  .vibe-line {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .vibe-name {
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: #ece7d8;
  }
  .vibe-soon {
    font-family: ui-monospace, monospace;
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    color: #d8a869;
    border: 1px solid rgba(216, 168, 105, 0.5);
    padding: 2px 7px;
  }
  .deck-mail {
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    letter-spacing: 0.06em;
    color: #ece7d8;
    text-decoration: none;
    border-bottom: 2px solid #b5372c;
    padding-bottom: 4px;
    transition: color 240ms ease;
  }
  .deck-mail:hover,
  .deck-mail:focus-visible {
    color: #d8696a;
  }
  .deck-mail:focus-visible {
    outline: 1px solid rgba(236, 231, 216, 0.6);
    outline-offset: 4px;
  }
  .deck-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .deck-socials a {
    font-family: ui-monospace, 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    color: rgba(236, 231, 216, 0.62);
    text-decoration: none;
    border: 1px solid rgba(236, 231, 216, 0.3);
    padding: 8px 13px;
    transition: color 240ms ease, border-color 240ms ease;
  }
  .deck-socials a:hover,
  .deck-socials a:focus-visible {
    color: #ece7d8;
