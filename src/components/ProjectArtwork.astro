---
import InkText from './InkText.astro';
interface Props {
  project: 'medit' | 'singularity';
}
const { project } = Astro.props;
---

<div class="project-artwork" aria-hidden="true">
  <InkText text={project === 'medit' ? '靜觀' : '宇宙之大'} />
</div>
<style>
  .project-artwork {
    display: grid;
    place-items: center;
    background: #e5dac3;
    min-height: 230px;
  }
  .project-artwork :global(.ink-text) {
    gap: 16px;
  }
  .project-artwork :global(.ink-glyph) {
    width: 60px;
    height: 90px;
  }
</style>
