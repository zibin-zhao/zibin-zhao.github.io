---
import { pathFor, type Lang } from '../lib/i18n';
import PastDesignLinks from './PastDesignLinks.astro';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {new Date().getFullYear()} Zibin Zhao</span>
    <nav aria-label={lang === 'en' ? 'Footer navigation' : '页脚导航'}>
      <a href={pathFor('prompts', lang)}>{lang === 'en' ? 'Prompt library' : '提示词库'}</a>
      <a href={pathFor('cv', lang)}>CV</a>
      <a href="https://github.com/zibin-zhao">GitHub <span aria-hidden="true">↗</span></a>
      <a href={pathFor('contact', lang)}>{lang === 'en' ? 'Contact' : '联系'}</a>
    </nav>
  </div>
  <div class="footer-afterword container">
    <details class="source-credits">
      <summary>{lang === 'en' ? 'Calligraphy & sources' : '书法与来源'}</summary>
      <p>
        <a href="https://commons.wikimedia.org/wiki/File:LantingXu.jpg"
          >Lanting Xu, Feng Chengsu after Wang Xizhi</a
        >. Public-domain reproduction. The opening is a contemporary composition using fragments of
        this copy. Additional reading text uses system typography, not a complete Wang Xizhi font.
      </p>
    </details>
    <PastDesignLinks lang={lang} />
  </div>
</footer>
