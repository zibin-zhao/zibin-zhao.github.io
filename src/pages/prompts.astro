---
import Base from '../layouts/Base.astro';
import PromptBlock from '../components/PromptBlock.astro';
import { promptPack as P } from '../data/prompts';
---
<Base title="Prompt Pack — Zibin Zhao" description="A copy-paste prompt pack for writing a CRISPR-Cas molecular-dynamics review with AI — an anti-hallucination, stage-by-stage research pipeline.">
  <div class="page">
    <header class="prompt-bar">
      <a class="prompt-index-label" href="/">ZIBINZHAO.COM · PROMPT ARCHIVE</a>
      <a class="back" href="/">← Back to site</a>
    </header>

    <section class="prompt-hero">
      <p class="kicker">{P.kicker}</p>
      <h1>{P.title}</h1>
      <p class="intro">{P.intro}</p>
      <div class="meta">
        <div class="mrow"><span class="ml">Running example</span><span class="mv">{P.runningExample}</span></div>
        <div class="mrow"><span class="ml">How to use</span><span class="mv">{P.howToUse}</span></div>
      </div>
    </section>

    <nav class="stagenav" id="stagenav" aria-label="Pipeline stages">
      {P.stages.map(s => (
        <a href={`#stage-${s.num}`} data-stage={s.num}><b>{s.num}</b><span>{s.title}</span></a>
      ))}
    </nav>

    <main class="stages" id="main-content">
      {P.stages.map(s => (
        <section class:list={['stage-card', 'stage']} id={`stage-${s.num}`}>
          <header class="stage-heading">
            <span class="stage-number">{s.num}</span>
            <div>
              <h2>{s.title}</h2>
              <span class:list={['tool', s.frontier && 'frontier']}>{s.tool}</span>
            </div>
          </header>
          {s.note && <p class="note">{s.note}</p>}
          {s.blocks.map((block) => <PromptBlock label={block.label} text={block.text} />)}
          {s.afterNote && <p class="after">↳ {s.afterNote}</p>}
        </section>
      ))}
    </main>

    <section class="discipline">
      <h2 class="dlabel">{P.disciplineTitle}</h2>
      <ul>{P.discipline.map(d => <li>{d}</li>)}</ul>
    </section>

    <footer class="foot">
      <a class="home" href="/">← Back to zibinzhao.com</a>
    </footer>
  </div>

  <script is:inline>
    (() => {
      // one-click copy
      document.querySelectorAll('.copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const pre = btn.parentElement && btn.parentElement.querySelector('.ptext');
          const text = pre ? pre.textContent : '';
          try { await navigator.clipboard.writeText(text); }
          catch { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (e) {} ta.remove(); }
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1600);
        });
      });
      // scroll-spy: highlight the active stage in the sticky nav
      const links = [...document.querySelectorAll('.stagenav a')];
      const byStage = Object.fromEntries(links.map((a) => [a.dataset.stage, a]));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = e.target.id.replace('stage-', '');
          links.forEach((a) => a.classList.remove('active'));
          const a = byStage[id];
          if (a) { a.classList.add('active'); a.scrollIntoView({ block: 'nearest', inline: 'center' }); }
        });
      }, { rootMargin: '-42% 0px -52% 0px' });
      document.querySelectorAll('.stage').forEach((s) => io.observe(s));
    })();
  </script>
</Base>

<style>
  :global(.skip-link) {
    position: fixed;
    z-index: 50;
    top: 12px;
    left: 12px;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 9px 11px;
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
    font: 500 11px/1.2 var(--font-note);
    text-transform: uppercase;
    transform: translateY(calc(-100% - 24px));
    transition: transform var(--motion-fast) var(--ease-press);
  }

  :global(.skip-link:focus-visible) {
    transform: none;
  }

  .page {
    min-height: 100vh;
    padding: var(--page-pad);
  }

  .prompt-bar,
  .prompt-index-label,
  .back,
  .stagenav,
  .stage-card,
  .meta,
  .discipline {
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
  }

  .prompt-bar {
    display: flex;
    max-width: var(--content-max);
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin: 0 auto;
    padding: 10px 12px;
    transform: rotate(-.35deg);
  }

  .prompt-index-label,
  .back {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 7px 9px;
    font: 500 11px/1 var(--font-note);
    text-transform: uppercase;
    transition: background var(--motion-fast) var(--ease-press), color var(--motion-fast) var(--ease-press), transform var(--motion-fast) var(--ease-press);
  }

  .prompt-index-label:hover,
  .back:hover {
    background: var(--green-bright);
    transform: translate(-1px, -1px);
  }

  .prompt-hero {
    max-width: 880px;
    margin: 0 auto;
    padding: 90px 20px 24px;
    text-align: left;
  }

  .kicker {
    color: var(--muted);
    font: 500 11px/1.3 var(--font-note);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .prompt-hero h1 {
    max-width: 820px;
    margin: 16px 0 20px;
    font: 400 clamp(42px, 7vw, 78px)/.98 var(--font-display);
    letter-spacing: .01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .intro {
    max-width: 72ch;
    color: var(--muted);
    font-size: clamp(15px, 2vw, 18px);
    line-height: 1.72;
    text-wrap: pretty;
  }

  .meta {
    max-width: 760px;
    margin-top: 30px;
    padding: 8px 20px;
  }

  .mrow {
    display: flex;
    gap: 18px;
    padding: 14px 0;
    font-size: 13.5px;
    line-height: 1.55;
  }

  .mrow + .mrow {
    border-top: 1px solid var(--ink);
  }

  .ml {
    flex: 0 0 124px;
    font: 500 11px/1.4 var(--font-note);
    text-transform: uppercase;
  }

  .mv {
    color: var(--muted);
  }

  .stagenav {
    position: sticky;
    top: var(--page-pad);
    z-index: 30;
    display: flex;
    max-width: 980px;
    gap: 6px;
    margin: 22px auto 0;
    overflow-x: auto;
    padding: 8px;
    scrollbar-width: none;
  }

  .stagenav::-webkit-scrollbar {
    display: none;
  }

  .stagenav a {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 8px;
    flex: 0 0 auto;
    padding: 9px 12px;
    color: var(--muted);
    font: 500 11px/1.2 var(--font-note);
    white-space: nowrap;
    transition: background var(--motion-fast) var(--ease-press), color var(--motion-fast) var(--ease-press);
  }

  .stagenav a b {
    color: var(--ink);
    font: 400 17px/1 var(--font-display);
  }

  .stagenav a:hover {
    background: var(--green-bright);
    color: var(--ink);
  }

  .stagenav a.active {
    background: var(--ink);
    color: var(--paper);
  }

  .stagenav a.active b {
    color: var(--paper);
  }

  .stages {
    max-width: 980px;
    margin: 0 auto;
  }

  .stage-card {
    max-width: 980px;
    margin: 28px auto 0;
    padding: clamp(22px, 4vw, 38px);
    scroll-margin-top: 110px;
  }

  .stage-card:nth-child(even) {
    transform: translateX(clamp(0px, 2vw, 24px)) rotate(.25deg);
  }

  .stage-heading {
    display: flex;
    align-items: flex-start;
    gap: clamp(14px, 3vw, 24px);
    padding-bottom: 18px;
    border-bottom: 2px solid var(--ink);
  }

  .stage-number {
    min-width: 54px;
    border: 1px solid var(--ink);
    padding: 6px;
    color: var(--ink);
    background: var(--orange);
    font: 400 clamp(44px, 7vw, 72px)/.82 var(--font-display);
  }

  .stage-heading h2 {
    font: 400 clamp(28px, 4vw, 42px)/1 var(--font-display);
    letter-spacing: .01em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .tool {
    display: inline-block;
    margin-top: 10px;
    padding: 5px 8px;
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--muted);
    font: 500 10px/1.2 var(--font-note);
    text-transform: uppercase;
  }

  .tool.frontier {
    background: var(--green-bright);
    color: var(--ink);
  }

  .note {
    margin: 20px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--ink);
    background: var(--paper-deep);
    color: var(--muted);
    font-size: 14px;
    font-style: italic;
    line-height: 1.6;
  }

  .after {
    margin-top: 18px;
    color: var(--muted);
    font: 500 12px/1.55 var(--font-note);
  }

  .discipline {
    max-width: 980px;
    margin: 34px auto 0;
    padding: clamp(28px, 5vw, 44px);
    background: var(--green);
  }

  .dlabel {
    max-width: 700px;
    margin-bottom: 22px;
    font: 400 clamp(30px, 5vw, 52px)/1 var(--font-display);
    text-transform: uppercase;
  }

  .discipline ul {
    display: flex;
    max-width: 76ch;
    flex-direction: column;
    gap: 14px;
    list-style: none;
  }

  .discipline li {
    position: relative;
    padding-left: 24px;
    color: var(--ink);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .discipline li::before {
    position: absolute;
    top: 9px;
    left: 0;
    width: 9px;
    height: 9px;
    border: 1px solid var(--ink);
    background: var(--orange);
    content: '';
  }

  .foot {
    max-width: 980px;
    margin: 32px auto 8px;
    text-align: center;
  }

  .foot .home {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    padding: 9px 11px;
    border: var(--stroke);
    background: var(--paper-card);
    box-shadow: var(--shadow-control);
    font: 500 11px/1.2 var(--font-note);
    text-transform: uppercase;
  }

  .foot .home:hover {
    background: var(--green-bright);
  }

  @media (max-width: 640px) {
    .page {
      padding: 14px;
    }

    .prompt-bar {
      align-items: stretch;
      transform: none;
    }

    .prompt-index-label,
    .back {
      display: flex;
      align-items: center;
      font-size: 9px;
      line-height: 1.25;
    }

    .prompt-index-label {
      max-width: 190px;
    }

    .prompt-hero {
      padding: 64px 6px 18px;
    }

    .mrow {
      flex-direction: column;
      gap: 6px;
    }

    .ml {
      flex-basis: auto;
    }

    .stagenav {
      top: 14px;
    }

    .stagenav a span {
      display: none;
    }

    .stagenav a {
      min-width: 40px;
      justify-content: center;
      padding: 9px 10px;
    }

    .stage-card:nth-child(n) {
      transform: none;
    }

    .stage-number {
      min-width: 40px;
    }

    .discipline {
      box-shadow: 4px 4px 0 var(--ink);
    }
  }
</style>
