---
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import LangToggle from '../components/LangToggle.astro';
import PromptBlock from '../components/PromptBlock.astro';
import { profile } from '../data/profile';
import { promptPack as P } from '../data/prompts';
---
<Base title="Prompt Pack — Zibin Zhao" description="A copy-paste prompt pack for writing a CRISPR-Cas molecular-dynamics review with AI — an anti-hallucination, stage-by-stage research pipeline.">
  <div class="page">
    <header class="bar">
      <a class="logo" href="/">{profile.name}</a>
      <div class="right">
        <LangToggle />
        <a class="back" href="/"><T en="← Back to site" zh="← 返回主页" /></a>
      </div>
    </header>

    <section class="hero">
      <div class="kicker">— <T en={P.kicker.en} zh={P.kicker.zh} /> —</div>
      <h1 class="big">{P.title}</h1>
      <p class="intro">{P.intro}</p>
      <div class="meta">
        <div class="mrow"><span class="ml"><T en="Running example" zh="示例主题" /></span><span class="mv">{P.runningExample}</span></div>
        <div class="mrow"><span class="ml"><T en="How to use" zh="如何使用" /></span><span class="mv">{P.howToUse}</span></div>
      </div>
    </section>

    <nav class="stagenav" id="stagenav" aria-label="Pipeline stages">
      {P.stages.map(s => (
        <a href={`#stage-${s.num}`} data-stage={s.num}><b>{s.num}</b><span>{s.title}</span></a>
      ))}
    </nav>

    <main class="stages">
      {P.stages.map(s => (
        <section class="stage" id={`stage-${s.num}`}>
          <div class="shead">
            <span class="snum">{s.num}</span>
            <div class="sh">
              <h2 class="stitle">{s.title}</h2>
              <span class:list={['tool', s.frontier && 'frontier']}>{s.tool}</span>
            </div>
          </div>
          {s.note && <p class="note">{s.note}</p>}
          {s.blocks.map(b => <PromptBlock label={b.label} text={b.text} />)}
          {s.afterNote && <p class="after">↳ {s.afterNote}</p>}
        </section>
      ))}
    </main>

    <section class="discipline">
      <div class="dlabel"><T en={P.disciplineTitle.en} zh={P.disciplineTitle.zh} /></div>
      <ul>{P.discipline.map(d => <li>{d}</li>)}</ul>
    </section>

    <footer class="foot">
      <a class="home" href="/"><T en="← Back to zibinzhao.com" zh="← 返回 zibinzhao.com" /></a>
    </footer>
  </div>

  <script>import '../scripts/lang.ts';</script>
  <script is:inline>
    (() => {
      // one-click copy
      document.querySelectorAll('.copy').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const pre = btn.parentElement && btn.parentElement.querySelector('.ptext');
          const text = pre ? pre.textContent : '';
          try { await navigator.clipboard.writeText(text); }
          catch { const ta = document.createElement('textarea'); ta.value = text; document.body.appendChild(ta); ta.select(); try { document.execCommand('copy'); } catch (e) {} ta.remove(); }
          btn.classList.add('copied');
          setTimeout(() => btn.classList.remove('copied'), 1600);
        });
      });
      // scroll-spy: highlight the active stage in the sticky nav
      const links = [...document.querySelectorAll('.stagenav a')];
      const byStage = Object.fromEntries(links.map((a) => [a.dataset.stage, a]));
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const id = e.target.id.replace('stage-', '');
          links.forEach((a) => a.classList.remove('active'));
          const a = byStage[id];
          if (a) { a.classList.add('active'); a.scrollIntoView({ block: 'nearest', inline: 'center' }); }
        });
      }, { rootMargin: '-42% 0px -52% 0px' });
      document.querySelectorAll('.stage').forEach((s) => io.observe(s));
    })();
  </script>
</Base>

<style>
  .page{min-height:100vh;background:var(--bg);padding:var(--gap)}
  .bar{display:flex;justify-content:space-between;align-items:center;padding:13px 24px;background:rgba(255,255,255,.82);backdrop-filter:blur(12px);border-radius:22px;box-shadow:0 8px 26px rgba(0,0,0,.08)}
  .bar .logo{font-family:var(--font-display);font-weight:800;letter-spacing:-1px;font-size:17px}
  .bar .right{display:flex;align-items:center;gap:12px}
  .bar .back{font-size:14px;color:var(--muted)}

  .hero{max-width:880px;margin:0 auto;padding:50px 20px 8px;text-align:center}
  .kicker{font-size:12px;letter-spacing:3px;text-transform:uppercase;color:#a1a1aa;font-weight:700}
  h1.big{font-family:var(--font-display);font-weight:800;letter-spacing:-1.5px;font-size:clamp(32px,5vw,52px);line-height:1.05;margin:14px auto 14px;max-width:760px}
  .intro{color:var(--muted);font-size:15.5px;line-height:1.7;max-width:680px;margin:0 auto}
  .meta{max-width:680px;margin:24px auto 0;text-align:left;background:#fff;border:1px solid var(--hair);border-radius:16px;padding:6px 20px}
  .mrow{display:flex;gap:16px;padding:13px 0;font-size:13.5px;line-height:1.55}
  .mrow + .mrow{border-top:1px solid #f0f0f0}
  .ml{flex:0 0 116px;font-weight:700;color:var(--ink)}
  .mv{color:var(--muted)}

  .stagenav{position:sticky;top:var(--gap);z-index:30;max-width:980px;margin:22px auto 0;display:flex;gap:6px;overflow-x:auto;
    padding:8px;background:rgba(255,255,255,.9);backdrop-filter:blur(12px);border:1px solid var(--hair);border-radius:18px;box-shadow:0 6px 20px rgba(0,0,0,.07);scrollbar-width:none}
  .stagenav::-webkit-scrollbar{display:none}
  .stagenav a{display:inline-flex;align-items:center;gap:8px;white-space:nowrap;font-size:13px;color:var(--muted);padding:8px 13px;border-radius:12px;transition:background .2s,color .2s}
  .stagenav a b{font-family:var(--font-display);font-weight:800;font-size:13px;color:#a1a1aa;transition:color .2s}
  .stagenav a:hover{background:rgba(0,0,0,.04)}
  .stagenav a.active{background:var(--ink);color:#fff}
  .stagenav a.active b{color:#fff}
  @media (max-width:640px){ .stagenav a span{display:none} .stagenav a{padding:9px 12px} .stagenav a b{font-size:14px} }

  .stages{max-width:980px;margin:0 auto}
  .stage{background:#fff;border:1px solid var(--hair);border-radius:22px;padding:30px 32px;margin-top:18px;scroll-margin-top:96px}
  .shead{display:flex;gap:18px;align-items:flex-start}
  .snum{font-family:var(--font-display);font-weight:800;font-size:46px;line-height:.9;color:#e4e4e7;flex:0 0 auto;min-width:54px}
  .sh{padding-top:4px}
  .stitle{font-family:var(--font-display);font-weight:800;letter-spacing:-.5px;font-size:23px;line-height:1.15}
  .tool{display:inline-block;margin-top:8px;font-size:12px;border:1px solid var(--hair);border-radius:12px;padding:3px 11px;color:var(--muted)}
  .tool.frontier{border-color:var(--ink);color:var(--ink);font-weight:600}
  .note{margin:16px 0 0;padding-left:14px;border-left:3px solid var(--hair);color:var(--muted);font-size:14px;line-height:1.6;font-style:italic}
  .after{margin-top:14px;color:var(--muted);font-size:13.5px;font-weight:500}

  .discipline{max-width:980px;margin:24px auto 0;background:var(--ink);color:#fff;border-radius:22px;padding:36px 38px}
  .dlabel{font-family:var(--font-display);font-weight:800;letter-spacing:-.5px;font-size:22px;margin-bottom:14px}
  .discipline ul{list-style:none;display:flex;flex-direction:column;gap:14px}
  .discipline li{position:relative;padding-left:22px;color:#d4d4d8;font-size:14.5px;line-height:1.65}
  .discipline li::before{content:"";position:absolute;left:0;top:9px;width:8px;height:8px;border-radius:50%;background:var(--accent)}

  .foot{max-width:980px;margin:26px auto 8px;text-align:center}
  .foot .home{font-size:14px;color:var(--muted)}
  @media (max-width:560px){ .stage{padding:24px 20px} .snum{font-size:38px;min-width:42px} .shead{gap:12px} .discipline{padding:28px 22px} }
</style>
