---
import Base from './Base.astro';
import StitchAtmosphere from '../components/StitchAtmosphere.astro';
import StitchFooterDock from '../components/StitchFooterDock.astro';
import StitchHeader from '../components/StitchHeader.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  home?: boolean;
}

const { title, description, active, home = false } = Astro.props;
---
<Base title={title} description={description}>
  <div class:list={['stitch-shell', home && 'stitch-shell--home']}>
    <StitchAtmosphere home={home} />
    <StitchHeader />
    <main id="main-content" class="stitch-main" tabindex="-1">
      <slot />
    </main>
    <StitchFooterDock active={active} />
  </div>
  <script>import '../scripts/lang.ts';</script>
</Base>

<style>
  .stitch-shell { min-height: 100vh; }
  .stitch-main {
    position: relative;
    z-index: 10;
    width: 100%;
    min-height: calc(100vh - 80px);
    padding-bottom: calc(var(--footer-reserve) + env(safe-area-inset-bottom));
  }
  @media (min-width: 701px) and (max-width: 960px) {
    .stitch-main { padding-bottom: calc(190px + env(safe-area-inset-bottom)); }
  }
  @media (max-width: 700px) {
    .stitch-main { padding-bottom: 32px; }
  }
</style>
