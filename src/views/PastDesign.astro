---
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '../styles/past-designs.css';
import { pastDesigns, pastPath, replayPath, type PastDesign } from '../data/past-designs';
import { t, pathFor, type Lang } from '../lib/i18n';
interface Props {
  entry: PastDesign;
  lang: Lang;
}
const { entry, lang } = Astro.props;
const zh = lang === 'zh';
const index = entry.number - 1;
const previous = pastDesigns[(index - 1 + pastDesigns.length) % pastDesigns.length]!;
const next = pastDesigns[(index + 1) % pastDesigns.length]!;
---

<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t(entry.title, lang)} · {zh ? '往昔' : 'Past designs'} · Zibin Zhao</title>
    <meta name="description" content={t(entry.note, lang)} />
    <meta name="robots" content="noindex,follow" />
    <meta name="theme-color" content="#eee5d3" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="past-viewer">
    <a class="archive-skip" href="#design-navigation">{zh ? '跳到版本选择' : 'Skip to editions'}</a>
    <header class="archive-header">
      <a class="archive-home" href={pathFor('home', lang)}
        ><span aria-hidden="true">↖</span> {zh ? '回到字里行间' : 'Back to the writing'}</a
      >
      <div class="archive-identity">
        <span class="archive-edition"
          >{String(entry.number).padStart(2, '0')} / {pastDesigns.length}</span
        >
        <h1>{t(entry.title, lang)}</h1>
        <time datetime={entry.date}>{entry.date.replaceAll('-', '.')}</time>
      </div>
      <a class="archive-expand" href={replayPath(entry, lang)}
        >{zh ? '展开旧站' : 'Open full page'} <span aria-hidden="true">↗</span></a
      >
    </header>
    <main class="archive-stage">
      <iframe
        src={replayPath(entry, lang)}
        title={`${zh ? '历史网站' : 'Historical website'} · ${t(entry.title, lang)} · ${entry.date}`}
        data-design-frame
        referrerpolicy="no-referrer"></iframe>
    </main>
    <footer class="archive-footer">
      <div class="archive-caption">
        <p>{t(entry.note, lang)}</p>
        <span>{zh ? '保留当时的设计与文字。' : 'Design and words as they were.'}</span>
      </div>
      <nav id="design-navigation" aria-label={zh ? '切换历史版本' : 'Choose a past design'}>
        <a
          class="archive-step"
          href={pastPath(previous.id, lang)}
          aria-label={zh ? '上一个版本' : 'Previous design'}>←</a
        >
        <ol>
          {
            pastDesigns.map((design) => (
              <li>
                <a
                  href={pastPath(design.id, lang)}
                  aria-current={design.id === entry.id ? 'page' : undefined}
                  aria-label={`${design.number} · ${t(design.title, lang)}`}
                  title={t(design.title, lang)}
                >
                  {design.number}
                </a>
              </li>
            ))
          }
        </ol>
        <a
          class="archive-step"
          href={pastPath(next.id, lang)}
          aria-label={zh ? '下一个版本' : 'Next design'}>→</a
        >
      </nav>
    </footer>
    <script>
      const strip = document.querySelector<HTMLOListElement>('.archive-footer ol');
      const selected = strip?.querySelector<HTMLAnchorElement>('[aria-current="page"]');
      if (strip && selected) {
        const alignSelected = () => {
          const item = selected.getBoundingClientRect();
          const list = strip.getBoundingClientRect();
          strip.scrollLeft += item.left - list.left - (list.width - item.width) / 2;
        };
        // Keep the selected edition visible after CSS, fonts, or viewport changes settle.
        new ResizeObserver(alignSelected).observe(strip);
        document.fonts.ready.then(alignSelected);
      }
    </script>
  </body>
</html>
