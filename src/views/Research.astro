---
import { getCollection } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import PublicationList from '../components/PublicationList.astro';
import { type Lang } from '../lib/i18n';
import { sortPubs } from '../data/pubs';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const entries = await getCollection('publications');
const sorted = sortPubs(
  entries.map((entry) => ({ ...entry, year: entry.data.year, title: entry.data.title })),
);
const journal = sorted.filter((publication) => publication.data.kind === 'journal');
const preprints = sorted.filter((publication) => publication.data.kind === 'preprint');
---

<div class="container">
  <PageIntro
    title={lang === 'en' ? 'Research' : '研究'}
    description={lang === 'en'
      ? 'I work on molecular diagnostics, aptamer design, and computational biology at Hsing Lab, HKUST. Publications and the associated code are collected below.'
      : '我在香港科技大学 Hsing 实验室研究分子诊断、适体设计与计算生物学。下面是论文与相关代码。'}
  >
    <div class="actions">
      <a class="text-link" href="https://scholar.google.com/citations?user=EQ6DTNkAAAAJ"
        >Google Scholar <span aria-hidden="true">↗</span></a
      >
      <a class="text-link" href="https://orcid.org/0000-0002-3121-9131"
        >ORCID <span aria-hidden="true">↗</span></a
      >
    </div>
  </PageIntro>
  <section class="section" aria-labelledby="journal-title">
    <div class="section-heading">
      <h2 id="journal-title">{lang === 'en' ? 'Journal articles' : '期刊论文'}</h2>
      <span class="muted">{journal.length} {lang === 'en' ? 'articles' : '篇'}</span>
    </div>
    <PublicationList publications={journal} lang={lang} />
  </section>
  <section class="section" aria-labelledby="preprint-title">
    <div class="section-heading">
      <h2 id="preprint-title">{lang === 'en' ? 'Preprints' : '预印本'}</h2>
    </div>
    <PublicationList publications={preprints} lang={lang} />
    <p class="research-note" style="margin-top:24px">
      {
        lang === 'en'
          ? 'Earlier versions of published work are linked with the journal article above.'
          : '已发表工作的早期版本，附在上方对应的期刊论文条目中。'
      }
    </p>
  </section>
</div>
